    {
      "name": "Circuitborn Heritage: Parallax",
      "type": "feat",
      "img": "art/bbttcc/asli-icons/circuitborn_synapse_1.webp",
      "system": {
        "category": "heritage",
        "source": {
          "custom": "Bad Eden",
          "rules": "2024",
          "revision": 2,
          "book": "",
          "license": ""
        },
        "tags": [],
        "description": {
          "value": "\n<p><strong>Circuitborn Line.</strong> The paradox-walking. Designed to be in the place no one expects, two seconds before the rest of the world catches up.</p><p><em>“Don’t look at where I am. Look at where I’m about to have already been.”</em></p><p><strong>Parallax.</strong> You are a sentient chassis built around the principle of <em>positional doubt</em>. The world keeps a fuzzy outline of where you are, and that fuzziness is your weapon.</p><h3>Traits</h3><ul><li><strong>Creature Type.</strong> Humanoid (Construct-Living).</li><li><strong>Chassis Lean.</strong> Your chassis is built around <strong>INTR (Intrigue)</strong>—expressed primarily through Tier powers.</li><li><strong>Phase Drift.</strong> Once per turn, when you move on your turn (your Disengage), you may slip 2 more squares.</li></ul>",
          "chat": ""
        },
        "advancement": [
          {
            "_id": "cbparallaxadv001",
