    {
      "_id": "wvtM4Bu9co0XkKoK",
      "name": "Aura of Chaos",
      "type": "feature",
      "img": "icons/magic/fire/explosion-fireball-medium-orange.webp",
      "system": {
        "category": "principle",
        "source": "Qliphothic Bestiary",
        "tags": [],
        "description": {
          "value": "<p>At the start of each of the Abomination's turns, roll 1d6:<br>1 — every creature within 6 squares takes 2d6 kinetic damage (reality hiccups).<br>2 — every creature within 6 squares rolls Body vs DC 18 or is flung 6 squares in a random direction.<br>3 — the Abomination regains 15 Integrity.<br>4 — all active manifestations within 12 squares are suppressed until its next turn.<br>5 — gravity forgets its job in a 6-square radius: flying, floating, falling upward, GM narrates.<br>6 — the Abomination takes an extra action this turn.</p>",
          "chat": ""
        }
      },
      "effects": [],
      "folder": null,
      "sort": 100000,
      "ownership": {
        "default": 0
      },
      "flags": {
        "fourththing": {
          "npcAuto": {
            "v": 1,
            "rules": [
              {
                "on": "selfTurnStart",
                "do": {
                  "random": [
                    {
                      "label": "reality hiccups",
                      "who": "all",
                      "radius": 6,
                      "do": {
                        "damage": {
                          "formula": "2d6",
                          "type": "kinetic"
                        }
                      }
                    },
                    {
                      "label": "flung",
                      "who": "all",
                      "radius": 6,
                      "do": {
                        "save": {
                          "attr": "body",
                          "dc": 18,
                          "onSave": "negate"
                        }
                      }
                    },
                    {
                      "label": "it regains 15",
                      "to": "self",
                      "do": {
                        "heal": 15
                      }
                    },
                    {
                      "label": "suppression",
                      "who": "all",
                      "radius": 12,
                      "do": {
                        "impose": true,
                        "prompt": "Active manifestations within 12 squares are suppressed until its next turn."
                      }
                    },
                    {
                      "label": "gravity",
                      "who": "all",
                      "radius": 6,
                      "do": {
                        "condition": {
                          "key": "prone",
                          "duration": "1-round"
                        }
                      }
                    },
                    {
                      "label": "extra action",
                      "to": "self",
                      "do": {
                        "shift": 6,
                        "prompt": "The Abomination takes an extra action this turn."
                      }
                    }
                  ]
                },
                "label": "Aura of Chaos — roll 1d6"
              },
              {
                "on": "saveFail",
                "do": {
                  "push": 6
                },
                "label": "flung",
                "if": {
                  "weapon": "Aura of Chaos"
                }
              }
            ]
          }
        }
      },
