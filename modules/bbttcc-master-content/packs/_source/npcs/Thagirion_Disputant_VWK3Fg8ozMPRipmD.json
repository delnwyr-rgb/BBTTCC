      "system": {
        "category": "principle",
        "source": "Qliphothic Bestiary",
        "tags": [],
        "description": {
          "value": "<p>Any creature that starts its turn within 6 squares of the Disputant grows argumentative: it rolls twice-keep-worse on Presence checks to persuade or de-escalate, and rolls vs Resolve (DC 14) or becomes hostile toward one random creature within 6 squares — friend or foe — until the start of its next turn.</p>",
          "chat": ""
        }
      },
      "effects": [],
      "folder": null,
      "sort": 100000,
      "ownership": {
        "default": 0
      },
      "flags": {
