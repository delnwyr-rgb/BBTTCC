  "items": [
    {
      "name": "Territory",
      "type": "feat",
      "img": "icons/creatures/abilities/paw-print-tan.webp",
      "system": {
        "category": "technique",
        "source": "",
        "tags": [
          "bestiary",
          "lineage-wild",
          "lineage-trait"
        ],
        "description": {
          "value": "<p>Pack. The Alpha rerolls the lowest die on attack rolls against any creature within 1 square of an ally that isn't incapacitated. Burn-zone: while in cinder or smoke, her first attack each combat rerolls the lowest die and she is hidden until she acts.</p><p><em>It was here first. It intends to be here after.</em></p>",
          "chat": ""
        }
      },
      "effects": [],
