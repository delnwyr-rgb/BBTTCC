          "bestiary",
          "lineage-wild",
          "aura"
        ],
        "description": {
          "value": "<p>Allied wolves within 6 squares of the Alpha reroll the lowest die on their attack rolls. When the Alpha first drops below half Integrity, every allied wolf within 6 squares gains 5 temporary Integrity and may move 2 squares at once.</p><p><em>The pack does not look at her. It does not need to.</em></p>",
          "chat": ""
        }
      },
      "effects": [],
      "flags": {
