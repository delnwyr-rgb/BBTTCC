    {
      "_id": "ifJ6a0lyoF2EH7Ru",
      "name": "Chalice of Excess (Recharge 5–6)",
      "type": "feat",
      "img": "icons/containers/bags/pack-leather-stitched-tan.webp",
      "system": {
        "category": "technique",
        "source": "Qliphothic Bestiary",
        "tags": [],
        "description": {
          "value": "<p>The Reveller offers the chalice to one creature within 6 squares. Resolve check vs DC 14. Fail: the target drinks — it gains 10 temporary Integrity and rolls twice-keep-better on attacks for one round… and is now <strong>addicted</strong>: at the start of each of its turns, Soul check vs DC 14 or it must spend its action getting to the chalice for another drink. The addiction breaks on a Soma Break, or if the drinker is Calmed.</p>",
          "chat": ""
        }
      },
      "effects": [],
      "folder": null,
      "sort": 500000,
      "ownership": {
        "default": 0
      },
      "flags": {
        "fourththing": {
          "npcAuto": {
            "v": 1,
            "rules": [
              {
                "on": "use",
                "do": {
                  "save": {
                    "attr": "soul",
                    "dc": 14,
                    "onSave": "negate"
                  }
                }
              },
              {
                "on": "saveFail",
                "if": {
                  "weapon": "Chalice of Excess (Recharge 5–6)"
                },
                "do": {
                  "tempIntegrity": 10,
                  "prompt": "Drinks: twice-keep-better attacks 1 rd; addicted — Soul DC 14 each turn or go drink."
                }
              }
            ],
            "recharge": {
              "mode": "d6",
              "min": 5
            }
          }
        }
      },
