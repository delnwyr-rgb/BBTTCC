    {
      "name": "Speaks Only When Ending Things",
      "type": "feature",
      "img": "art/bbttcc/GOTTGAIT/BBTTCC%20Button%20Icons/BBTTCC_button_icon_speech_1.png",
      "system": {
        "category": "principle",
        "source": "",
        "tags": [
          "seed-bestiary-attacks",
          "tier-iv",
          "role-caster"
        ],
        "description": {
          "value": "<p><strong>Passive.</strong> The apotheon does not communicate during combat. The first time it speaks aloud in a scene, that scene ends within 1d4 rounds \u2014 narratively, mechanically, somehow. The GM picks how. The players know it is coming.</p><p><em>Silence, then a single sentence. The sentence is also the end credits.</em></p>",
          "chat": ""
        }
      },
