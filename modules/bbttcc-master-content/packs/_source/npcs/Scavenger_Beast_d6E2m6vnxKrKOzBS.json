        "category": "principle",
        "source": "lineage",
        "tags": [
          "lineage-trait",
          "wild",
          "predator"
        ],
        "description": {
          "value": "<p>Choose terrain (still water, burn-zone, rubble, canopy) or pack. Terrain: while in it, the first attack each combat rerolls the lowest die and the creature is hidden until it acts. Pack: reroll the lowest die on attack rolls against any creature within 1 square of an ally that isn't incapacitated.</p><p><em>It was here first. It intends to be here after.</em></p>",
          "chat": ""
        }
      },
      "flags": {
        "fourththing": {
          "npcAuto": {
            "v": 1,
            "rules": [
              {
                "on": "attack",
                "if": {
                  "firstRound": true
                },
                "do": {
                  "reroll": "attack"
                },
                "limit": {
                  "per": "combat",
                  "uses": 1
                },
                "label": "Territory — the first strike rerolls the lowest"
              },
              {
                "on": "attack",
                "if": {
                  "allyAdjacentToTarget": true
                },
                "do": {
                  "reroll": "attack"
                },
                "label": "Pack — reroll the lowest beside an ally"
              }
            ]
          },
