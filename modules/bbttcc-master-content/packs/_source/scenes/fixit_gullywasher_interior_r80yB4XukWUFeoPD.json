        "ownership": null,
        "flags": {
          "bbttcc-mal-voice": {
            "dialogue": {
              "messages": [
                {
                  "role": "user",
                  "content": "Toblerone: Hello Mr Dougan! I'm Toblerone, with the new Stewards from Allesh Gilliam. Ummm, you're a Chupacabra, right? Running a bar in a Jackalope Town?",
                  "speaker": "Toblerone",
                  "ts": 1783133943232
                },
                {
                  "role": "assistant",
                  "content": "*sets down the glass he's been polishing, looks Toblerone over with the frank, unhurried curiosity of a man used to strange company*\n\nDougan Marsh, at your service. And yes — Chupacabra, saloon-keeper, and about as unbothered by the arrangement as you are, friend. Furrier's don't much care what you were born as, so long as you pour a fair drink and keep your ledger honest. I do both. Most nights.\n\n*taps the bar twice, a habit more than a gesture*\n\nNow — Toblerone. That's a new one on me. Allesh-Gilliam, you said. You'll be here about the Gate trouble, or just thirsty? Either's a fine reason to sit.",
                  "speaker": "Dougan",
                  "ts": 1783133947813
                }
              ]
            }
          }
        },
        "_key": "!scenes.tokens.delta!r80yB4XukWUFeoPD.G0DlasK9wpTH84Zb.G0DlasK9wpTH84Zb"
