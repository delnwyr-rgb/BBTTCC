        ],
        "ownership": null,
        "flags": {
          "bbttcc-mal-voice": {
            "dialogue": {
              "messages": [
                {
                  "role": "user",
                  "content": "Toblerone: Heya Mara! Who is Dougan?",
                  "speaker": "Toblerone",
                  "ts": 1783103572498
                },
                {
                  "role": "assistant",
                  "content": "Dougan Marsh — runs the Gullywasher. Chupacabra, if you can believe it, but not the kind that'll give you nightmares. Fair dealer, slow to anger, gets along with near everybody, which frankly makes him a bit of an oddball in his own family tree. If he tells you a price, it's the real price. Why, you looking to do business with him?",
                  "speaker": "Mara Quickhands",
                  "ts": 1783103575969
                },
                {
                  "role": "user",
                  "content": "Toblerone: Maybe! Also, do you have a leygate stabilizer that we might be able to negotiate for? Ours in Allesh Gilliam is kaput!",
                  "speaker": "Toblerone",
                  "ts": 1783105101376
                },
                {
                  "role": "assistant",
                  "content": "Slow down there. We've got a stabilizer — Young Gearbox is the one actually holding it, out at the Arc Bay, and he'll tell you same as I will: anything serious, I'm at that table too. It's not a spare part, Toblerone, it's the only reason our own Gate isn't spitting out something with too many teeth.\n\nSo before we start talking trade — what's Allesh-Gilliam putting on the table? And I don't mean coin. I mean *weight*. What have you got that tells me you'll still be good for the debt a year from now?",
                  "speaker": "Mara Quickhands",
                  "ts": 1783105105887
                }
              ]
            }
          }
        },
        "_key": "!scenes.tokens.delta!mGVIhz93ZvBjGfK1.NvztSKtk1f8JcR5T.NvztSKtk1f8JcR5T"
