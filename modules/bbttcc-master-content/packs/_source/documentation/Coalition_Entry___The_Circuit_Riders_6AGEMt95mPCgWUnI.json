  "folder": "GukRAMhajbtRdTB2",
  "name": "Coalition Entry - The Circuit Riders",
  "_id": "6AGEMt95mPCgWUnI",
  "pages": [
    {
      "sort": 100000,
      "name": "Led by Captain Robot, a True Robot's Robot!",
      "type": "text",
      "_id": "naq9IjAW9Na4KosH",
      "system": {},
      "title": {
        "show": true,
        "level": 1
