        "modifiedTime": 1781116255233
      },
      "_key": "!journal.pages!XTqai5nZt42c3r2X.A9MAVXcKiOHYJfkh"
    },
    {
      "sort": 250000,
      "name": "Strategic Activities are like ...",
      "type": "text",
      "_id": "0mcwXZi7DHX1NZbn",
      "system": {},
      "title": {
        "show": true,
        "level": 1
      },
      "image": {},
      "text": {
        "format": 1,
        "content": "<p><em>… resource management in games like those discussed in the Hex section.</em></p><ul><li><p>They are OP powered initiatives designed to enhance, develop, or repair Hexes, Rigs, and Facilities.</p></li><li><p>They resolve on Strategic Turn Advancement.</p></li></ul>"
      },
      "video": {
        "controls": true,
        "volume": 0.5
      },
      "src": null,
      "category": null,
      "ownership": {
        "default": -1,
