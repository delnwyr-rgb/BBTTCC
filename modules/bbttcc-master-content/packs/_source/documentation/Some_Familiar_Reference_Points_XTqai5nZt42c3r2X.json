{
  "folder": "bDULV9cH00cnJHUX",
  "name": "Some Familiar Reference Points",
  "_id": "XTqai5nZt42c3r2X",
  "pages": [
    {
      "sort": 100000,
      "name": "Let's Try This",
      "type": "text",
      "_id": "sb4A5HHLcE7j6QNw",
      "system": {},
      "title": {
        "show": true,
        "level": 1
      },
      "image": {},
      "text": {
        "format": 1,
        "content": "<p>Bad Eden SHAMELESSLY rips off many many many many many … many other properties.</p><p></p><p>Or, less litigiously, owes much in spirit to endeavors that have gone before.</p><p></p><p>So - here's a way to wrap these concepts around their more familiar ancestors.</p>"
      },
      "video": {
        "controls": true,
        "volume": 0.5
      },
      "src": null,
      "category": null,
      "ownership": {
        "default": -1,
