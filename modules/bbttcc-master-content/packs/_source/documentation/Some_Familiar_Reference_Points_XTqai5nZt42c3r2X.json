    },
    {
      "sort": 700000,
      "name": "The malleability of the world is like ...",
      "type": "text",
      "_id": "GXEoajHHbV0KBCyu",
      "system": {},
      "title": {
        "show": true,
        "level": 1
      },
      "image": {},
      "text": {
        "format": 1,
        "content": "<p><em>… Shadesmar in the Stormlight Archive. The world remembers.</em></p><ul><li><p>It can be reasoned with.</p></li><li><p>It can be convinced.</p></li><li><p>It can be changed by clever arguments or raw violence.</p></li><li><p>If you believe you can fly, you can.</p></li></ul>"
      },
      "video": {
