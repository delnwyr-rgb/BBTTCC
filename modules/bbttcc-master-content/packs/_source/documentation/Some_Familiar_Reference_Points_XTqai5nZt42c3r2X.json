        "modifiedTime": 1781116255233
      },
      "_key": "!journal.pages!XTqai5nZt42c3r2X.TsaCClTVF2EcMSF9"
    },
    {
      "sort": 500000,
      "name": "Maneuvers are like ...",
      "type": "text",
      "_id": "A9MAVXcKiOHYJfkh",
      "system": {},
      "title": {
        "show": true,
        "level": 1
      },
      "image": {},
      "text": {
        "format": 1,
        "content": "<p><em>… cards in Magic the Gathering.</em></p><ul><li><p>They are special powers a Faction can use during their Raid action turn.</p></li><li><p>As a rule, they must be earned or discovered. They are, in essence, collectible, with some being far more rare than others.</p></li><li><p>They are organized by tier, from common to legendary.</p></li></ul>"
      },
      "video": {
        "controls": true,
        "volume": 0.5
      },
      "src": null,
      "category": null,
      "ownership": {
        "default": -1,
        "vmUfDuSYUIe7V5uB": 3
      },
      "flags": {},
      "_stats": {
        "compendiumSource": null,
        "duplicateSource": null,
        "exportSource": null,
        "coreVersion": "14.363",
        "systemId": "fourththing",
