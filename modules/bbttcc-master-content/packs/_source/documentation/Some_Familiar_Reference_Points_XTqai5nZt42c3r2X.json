      "_key": "!journal.pages!XTqai5nZt42c3r2X.0mcwXZi7DHX1NZbn"
    },
    {
      "sort": 600000,
      "name": "Factions are like ...",
      "type": "text",
      "_id": "bZrdgh0HFHuBoejp",
      "system": {},
      "title": {
        "show": true,
        "level": 1
      },
      "image": {},
      "text": {
        "format": 1,
        "content": "<p><em>… an adventuring party meets Sense8.</em> Because you are a faction, you draw power from a common source, which in turn draws its power from you.</p><ul><li><p>You may take energy from it. You may give energy back to it.</p></li><li><p>You can see through the eyes, and hear through the ears, of other members of your Faction.</p></li><li><p>You may share energy with other members of your faction through your faction's connection.</p></li></ul>"
      },
      "video": {
        "controls": true,
        "volume": 0.5
      },
      "src": null,
      "category": null,
      "ownership": {
