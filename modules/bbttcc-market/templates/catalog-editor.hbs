<section class="bbttcc-market-editor">
  <header class="bbttcc-market-editor__head">
    <div>
      <div class="bbttcc-market-title">Catalogs</div>
      <div class="bbttcc-muted">Drag & drop Items or Folders from the sidebar/compendiums into the drop zone below.</div>
    </div>
    <div class="bbttcc-market-editor__actions">
      <button type="button" class="bbttcc-button" data-action="vendor-add" data-tooltip="{{bbttccTip 'market' 'vendorAdd'}}" data-tour="market.vendorAdd"><i class="fas fa-plus"></i> Vendor</button>
      <button type="button" class="bbttcc-button" data-action="entry-add" data-tooltip="{{bbttccTip 'market' 'entryAdd'}}" data-tour="market.entryAdd"><i class="fas fa-plus"></i> Entry</button>
      <button type="button" class="bbttcc-button danger" data-action="vendor-del" data-tooltip="{{bbttccTip 'market' 'vendorDel'}}" data-tour="market.vendorDel"><i class="fas fa-trash"></i> Delete Market</button>
      <button type="button" class="bbttcc-button primary" data-action="save" data-tooltip="{{bbttccTip 'market' 'save'}}" data-tour="market.save"><i class="fas fa-save"></i> Save</button>
    </div>
  </header>

  <section class="bbttcc-market-editor__grid">
    <section class="bbttcc-card">
      <header class="bbttcc-card-header">
        <h2>Vendors</h2>
        <p>Select a vendor to edit its catalog entries.</p>
      </header>
      <div class="bbttcc-card-body">
        <div class="field" data-tooltip="{{bbttccTip 'market' 'editorVendor'}}" data-tour="market.editorVendor">
          <label>Vendor</label>
          <select data-role="vendor">
            {{#each vendors}}
              <option value="{{id}}" {{#if selected}}selected{{/if}}>{{displayName}}</option>
            {{/each}}
          </select>
        </div>

<div class="field" data-tooltip="{{bbttccTip 'market' 'vendorActive'}}" data-tour="market.vendorActive">
  <label>Active</label>
  <label class="bbttcc-checkline">
    <input type="checkbox" data-role="vendorActive" {{#if vendor.active}}checked{{/if}}/>
    <span>Visible to players</span>
  </label>
</div>

        <div class="field" data-tooltip="{{bbttccTip 'market' 'vendorName'}}" data-tour="market.vendorName">
          <label>Name</label>
          <input type="text" data-role="vendorName" value="{{vendor.name}}"/>
        </div>

        <div class="field" data-tooltip="{{bbttccTip 'market' 'vendorBlurb'}}" data-tour="market.vendorBlurb">
          <label>Blurb</label>
          <input type="text" data-role="vendorBlurb" value="{{vendor.blurb}}"/>
        </div>

        <div class="field" data-tooltip="{{bbttccTip 'market' 'vendorTags'}}" data-tour="market.vendorTags">
          <label>Tags (comma)</label>
          <input type="text" data-role="vendorTags" value="{{vendor.tagsRaw}}"/>
        </div>
      </div>
    </section>

    <section class="bbttcc-card">
      <header class="bbttcc-card-header" data-tooltip="{{bbttccTip 'market' 'editorEntries'}}">
        <h2>Entries</h2>
        <p>Edit entries or drop items/folders to import.</p>
      </header>

      <div class="bbttcc-card-body">
        <div class="bbttcc-market-drop" data-role="dropzone" data-tooltip="{{bbttccTip 'market' 'dropzone'}}" data-tour="market.dropzone">
          <div class="bbttcc-market-drop__title">Drop Items or Folders here</div>
          <div class="bbttcc-muted">Item drops become <b>Gear</b> entries with the item UUID prefilled.</div>
        </div>

        <div class="bbttcc-market-editor__list" data-tour="market.editorEntries">
          {{#each entries}}
            <article class="bbttcc-market-editor__row" data-entry-id="{{id}}">
              <div class="row2">
                <div class="field" data-tooltip="{{bbttccTip 'market' 'entryName'}}" {{#if @first}}data-tour="market.entryName"{{/if}}>
                  <label>Name</label>
                  <input type="text" data-k="name" value="{{name}}"/>
                </div>
                <div class="field" data-tooltip="{{bbttccTip 'market' 'entryKind'}}" {{#if @first}}data-tour="market.entryKind"{{/if}}>
                  <label>Kind</label>
                  <select data-k="kind">
                    <option value="gear" {{#if isGear}}selected{{/if}}>gear</option>
                    <option value="rig" {{#if isRig}}selected{{/if}}>rig</option>
                    <option value="facility" {{#if isFacility}}selected{{/if}}>facility</option>
                    <option value="hex_asset" {{#if isHexAsset}}selected{{/if}}>hex_asset</option>
                    <option value="rig_upgrade" {{#if isRigUpgrade}}selected{{/if}}>rig_upgrade</option>
                    <option value="facility_upgrade" {{#if isFacilityUpgrade}}selected{{/if}}>facility_upgrade</option>
                    <option value="actor" {{#if isActor}}selected{{/if}}>actor (Rig/Boss/NPC)</option>
                  </select>
                </div>
              </div>

              <div class="field" data-tooltip="{{bbttccTip 'market' 'entryCost'}}" {{#if @first}}data-tour="market.entryCost"{{/if}}>
                <label>Economy OP Cost</label>
                <input type="number" step="0.1" min="0" data-k="cost.economy" value="{{econ}}"/>
              </div>

              <div class="field" data-tooltip="{{bbttccTip 'market' 'entryBlurb'}}" {{#if @first}}data-tour="market.entryBlurb"{{/if}}>
                <label>Blurb</label>
                <input type="text" data-k="blurb" value="{{blurb}}"/>
              </div>

              <div class="field" data-tooltip="{{bbttccTip 'market' 'entryPayload'}}" {{#if @first}}data-tour="market.entryPayload"{{/if}}>
                <label>UUID (gear/actor) / Patch JSON (rig/facility/upgrades)</label>
                <textarea rows="2" data-k="payload">{{payload}}</textarea>
                <small>For gear/actor: UUID. For rig/facility: JSON. For upgrades: JSON patch.</small>
              </div>

              <div class="bbttcc-market-editor__rowActions">
                <button type="button" class="bbttcc-button" data-action="dup" data-tooltip="{{bbttccTip 'market' 'entryDup'}}" {{#if @first}}data-tour="market.entryDup"{{/if}}><i class="fas fa-copy"></i></button>
                <button type="button" class="bbttcc-button" data-action="del" data-tooltip="{{bbttccTip 'market' 'entryDel'}}" {{#if @first}}data-tour="market.entryDel"{{/if}}><i class="fas fa-trash"></i></button>
              </div>
            </article>
          {{/each}}
        </div>
      </div>
    </section>
  </section>
</section>
