<section class="bbttcc-market-root">
  {{#unless apiReady}}
    <div class="bbttcc-market-empty">
      <h2>Bad Eden Market</h2>
      <p class="bbttcc-muted">Market API not ready.</p>
    </div>
  {{else}}
    <header class="bbttcc-market-head">
      <div>
        <div class="bbttcc-market-title">Bad Eden Market</div>
        <div class="bbttcc-muted">{{#if lockedBuyer}}Spend your Domain's marks on gear and rigs — or ↺ sell what you carry.{{else}}Procurement console: spend a Domain's marks (pool set by item pricing) to buy gear, rigs, facilities, and hex assets — or ↺ sell what you carry.{{/if}}</div>
      </div>
      <div class="bbttcc-market-actions">
        {{#if isGM}}
        <button type="button" class="bbttcc-button" data-action="manage" data-tooltip="{{bbttccTip 'market' 'manage'}}" data-tour="market.manage">
          <i class="fas fa-gear"></i> Manage Catalogs
        </button>
        {{/if}}
      </div>
    </header>

    <section class="bbttcc-market-grid">
      <section class="bbttcc-card" data-tour="market.context">
        <header class="bbttcc-card-header" data-tooltip="{{bbttccTip 'market' 'context'}}">
          <h2>Context</h2>
          <p>Pick vendor, buyer, and (optionally) a delivery hex.</p>
        </header>

        <div class="bbttcc-card-body">
          <div class="field" data-tooltip="{{bbttccTip 'market' 'vendor'}}" data-tour="market.vendor">
            <label>Vendor</label>
            <select name="vendorId" data-role="vendor">
              {{#each vendors}}
                <option value="{{id}}" {{#if selected}}selected{{/if}}>{{displayName}}</option>
              {{/each}}
            </select>
          </div>

          {{#if lockedBuyer}}
          {{!-- Ruling 16 (2026-10-18): a player buys as their steward; the treasury IS their Domain. Locked, not chosen. --}}
          <div class="field" data-tooltip="{{bbttccTip 'market' 'faction'}}" data-tour="market.faction">
            <label>Treasury</label>
            <select name="factionId" data-role="faction" disabled>
              {{#each factions}}
                <option value="{{id}}" selected>{{name}}</option>
              {{else}}
                <option value="">(no Domain yet — ask the GM)</option>
              {{/each}}
            </select>
            <small>Your Domain's marks pay for everything here.</small>
          </div>

          <div class="field" data-tooltip="{{bbttccTip 'market' 'character'}}" data-tour="market.character">
            <label>Buying as</label>
            <select name="characterId" data-role="character">
              {{#each characters}}
                <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
              {{else}}
                <option value="">(no character)</option>
              {{/each}}
            </select>
            <small>Gear lands in this character's inventory.</small>
          </div>
          {{else}}
          <div class="field" data-tooltip="{{bbttccTip 'market' 'faction'}}" data-tour="market.faction">
            <label>Buyer Domain</label>
            <select name="factionId" data-role="faction">
              <option value="">(Select)</option>
              {{#each factions}}
                <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
              {{/each}}
            </select>
            <small>Marks are spent from this Domain's treasury.</small>
          </div>

          <div class="field" data-tooltip="{{bbttccTip 'market' 'character'}}" data-tour="market.character">
            <label>Buyer Character (for gear)</label>
            <select name="characterId" data-role="character">
              <option value="">(Optional)</option>
              {{#each characters}}
                <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
              {{/each}}
            </select>
            <small>Gear deliveries go to this character's inventory.</small>
          </div>
          {{/if}}

          <div class="field" data-tooltip="{{bbttccTip 'market' 'hex'}}" data-tour="market.hex">
            <label>Delivery Hex (facilities / hex assets)</label>
            <select name="hexUuid" data-role="hexUuid">
              <option value="" {{#unless hexUuid}}selected{{/unless}}>(Select a known hex)</option>
              {{#each deliveryOptions}}
                <option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{label}}</option>
              {{/each}}
              {{#if deliveryUnlisted}}
                <option value="{{deliveryUnlisted.uuid}}" selected>{{deliveryUnlisted.label}}</option>
              {{/if}}
              {{#if deliveryOtherOptions.length}}
                <optgroup label="Not known to the buyer (GM only)">
                  {{#each deliveryOtherOptions}}
                    <option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                  {{/each}}
                </optgroup>
              {{/if}}
            </select>
            <small class="bbttcc-market-delivery-note">{{deliveryNote}}</small>
          </div>

          <div class="field" data-tooltip="{{bbttccTip 'market' 'note'}}" data-tour="market.note">
            <label>Notes (receipt)</label>
            <input type="text" name="note" data-role="note" value="{{note}}" placeholder="Optional…"/>
          </div>
        </div>
      </section>

      <section class="bbttcc-card bbttcc-market-catalog" data-tour="market.catalog">
        <header class="bbttcc-card-header">
          <h2>Catalog <a href="#" class="bbttcc-market-howto" data-action="howto" title="How buying works — prices, horizon chips, pools, delivery">ⓘ How buying works</a></h2>
          <p>{{vendorName}}</p>
          {{#if vendorStatusLine}}<p class="bbttcc-muted">{{vendorStatusLine}}</p>{{/if}}
        </header>

        <div class="bbttcc-card-body">
          {{!-- Treasury: the buyer faction's OP banks, in marks (2026-10-12) --}}
          <div class="bbttcc-market-treasury" data-tooltip="{{bbttccTip 'market' 'treasury'}}" data-tour="market.treasury">
            {{#if treasury}}
              <span class="bbttcc-market-treasury__title">{{treasury.name}} <span class="bbttcc-muted">· Horizon {{treasury.horizonLabel}}</span></span>
              <span class="bbttcc-market-treasury__pools">
                {{#each treasury.pools}}
                  <span class="bbttcc-market-treasury__pool{{#if zero}} is-zero{{/if}}" title="{{key}} bank">{{short}} <b>{{marks}}</b></span>
                {{/each}}
              </span>
            {{else}}
              <span class="bbttcc-muted">{{#if lockedBuyer}}No Domain is linked to {{#if buyerCharacterName}}{{buyerCharacterName}}{{else}}your character{{/if}} yet — ask the GM.{{else}}Select a <b>Buyer Domain</b> to see its treasury and what it can afford.{{/if}}</span>
            {{/if}}
          </div>

          <div class="bbttcc-market-filters">
            <input type="text" data-role="q" value="{{q}}" placeholder="Search…" data-tooltip="{{bbttccTip 'market' 'search'}}" data-tour="market.search"/>
            <select data-role="costBand" data-tooltip="{{bbttccTip 'market' 'costBand'}}" data-tour="market.costBand">
              {{#each costBands}}
                <option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
            <select data-role="sort" data-tooltip="{{bbttccTip 'market' 'sort'}}" data-tour="market.sort">
              <option value="name"     {{#if (eq sort "name"    )}}selected{{/if}}>Sort: Name (A→Z)</option>
              <option value="tier_asc" {{#if (eq sort "tier_asc")}}selected{{/if}}>Sort: Tier (low→high)</option>
              <option value="tier_desc"{{#if (eq sort "tier_desc")}}selected{{/if}}>Sort: Tier (high→low)</option>
            </select>
            <label class="bbttcc-market-afford-toggle{{#unless hasFaction}} is-disabled{{/unless}}" data-tooltip="{{bbttccTip 'market' 'affordOnly'}}" data-tour="market.affordOnly">
              <input type="checkbox" data-role="affordOnly" {{#if affordOnly}}checked{{/if}} {{#unless hasFaction}}disabled{{/unless}}/>
              Only what we can afford
            </label>
          </div>

          {{!-- Always tabbed by gear type (2026-10-12). Keeps the old tour anchor. --}}
          <nav class="bbttcc-market-tabs" data-tooltip="{{bbttccTip 'market' 'tabs'}}" data-tour="market.category">
            {{#each tabs}}
              <button type="button" class="bbttcc-market-tab{{#if active}} active{{/if}}" data-action="tab" data-tab="{{key}}">{{label}} <span class="count">{{count}}</span></button>
            {{/each}}
          </nav>

          <div class="bbttcc-market-list">
            {{#if sellMode}}
              <div class="bbttcc-market-sell-head" data-tooltip="{{bbttccTip 'market' 'sell'}}">
                <p><b>{{sellLine}}</b></p>
                {{#if sellWarn}}<p class="bbttcc-muted">{{sellWarn}}</p>{{/if}}
              </div>
              {{#each sellRows}}
                <article class="bbttcc-market-item{{#unless sellable}} is-unaffordable{{/unless}}" data-item-uuid="{{uuid}}">
                  {{#if img}}
                    <img class="bbttcc-market-item__img" src="{{img}}" alt=""/>
                  {{else}}
                    <div class="bbttcc-market-item__img bbttcc-market-item__img--empty"></div>
                  {{/if}}
                  <div class="bbttcc-market-item__main">
                    <div class="bbttcc-market-item__name">
                      <a href="#" class="bbttcc-market-item__link" data-action="openDoc" data-uuid="{{uuid}}">{{name}}</a>
                      {{#if qtyLabel}}<span class="bbttcc-muted">{{qtyLabel}}</span>{{/if}}
                      {{#if sellable}}
                        <span class="bbttcc-market-afford ok" title="{{rateTitle}}">↺ {{payout}} marks each</span>
                      {{else}}
                        <span class="bbttcc-market-afford no" title="{{reason}}">✗ {{reason}}</span>
                      {{/if}}
                    </div>
                    <div class="bbttcc-muted">{{kindLabel}}{{#if tierLabel}} · {{tierLabel}}{{/if}} · List: <b>{{listLabel}}</b>{{#if sellable}} · pays {{rateLabel}}{{/if}}</div>
                  </div>
                  <div class="bbttcc-market-item__btns">
                    {{#if sellable}}
                      {{#if stack}}<input type="number" class="bbttcc-market-sell-qty" data-role="sellQty" min="1" max="{{qty}}" value="1" title="How many to sell"/>{{/if}}
                      <button type="button" class="bbttcc-button primary" data-action="sell">Sell</button>
                    {{/if}}
                  </div>
                </article>
              {{/each}}
              {{#unless sellRows.length}}
                <p class="bbttcc-muted">{{sellEmpty}}</p>
              {{/unless}}
            {{/if}}
            {{#each entries}}
              <article class="bbttcc-market-item{{#if affordKnown}}{{#unless canAfford}} is-unaffordable{{/unless}}{{/if}}" data-entry-id="{{id}}">
                {{#if img}}
                  <img class="bbttcc-market-item__img" src="{{img}}" alt=""/>
                {{else}}
                  <div class="bbttcc-market-item__img bbttcc-market-item__img--empty"></div>
                {{/if}}
                <div class="bbttcc-market-item__main">
                  <div class="bbttcc-market-item__name">
                    {{#if canOpen}}
                      <a href="#" class="bbttcc-market-item__link" data-action="openDoc" data-uuid="{{docUuid}}" data-tooltip="{{bbttccTip 'market' 'openDoc'}}" {{#if @first}}data-tour="market.openDoc"{{/if}}>{{name}}</a>
                    {{else}}
                      {{name}}
                    {{/if}}
                    {{#if affordKnown}}
                      {{#if canAfford}}
                        <span class="bbttcc-market-afford ok" title="Pays {{paysLabel}}">✓ {{paysLabel}}</span>
                      {{else}}
                        <span class="bbttcc-market-afford no" title="Pays {{paysLabel}}">✗ Short {{shortLabel}}</span>
                      {{/if}}
                    {{/if}}
                  </div>
                  <div class="bbttcc-muted" {{#if @first}}data-tour="market.cost"{{/if}}>{{kindLabel}}{{#if tierLabel}} · {{tierLabel}}{{/if}} · Cost: <b>{{costLabel}}</b></div>
                  {{#if blurb}}<div class="bbttcc-muted">{{blurb}}</div>{{/if}}
                </div>
                <div class="bbttcc-market-item__btns">
                  <button type="button" class="bbttcc-button primary" data-action="buy" {{#if @first}}data-tour="market.buy"{{/if}}>Buy</button>
                </div>
              </article>
            {{/each}}
            {{#unless sellMode}}{{#unless entries.length}}
              <p class="bbttcc-muted">No matching entries{{#if affordOnly}} you can afford{{/if}} in this tab.</p>
            {{/unless}}{{/unless}}
          </div>
        </div>
      </section>
    </section>
  {{/unless}}
</section>
