# Ignore everything by default
*

# Keep the Git internals
!.gitignore
!.gitattributes

# Allow each BBTTCC module (dir + contents)
!bbttcc-aae/
!bbttcc-aae/**
!bbttcc-auto-link/
!bbttcc-auto-link/**
!bbttcc-banks/
!bbttcc-banks/**
!bbttcc-campaign/
!bbttcc-campaign/**
!bbttcc-character-options/
!bbttcc-character-options/**
!bbttcc-core/
!bbttcc-core/**
!bbttcc-encounters/
!bbttcc-encounters/**
!bbttcc-epic/
!bbttcc-epic/**
!bbttcc-facility-console/
!bbttcc-facility-console/**
!bbttcc-factions/
!bbttcc-factions/**
!bbttcc-fx-integration/
!bbttcc-fx-integration/**
!bbttcc-mal-voice/
!bbttcc-mal-voice/**
!bbttcc-market/
!bbttcc-market/**
!bbttcc-master-content/
!bbttcc-master-content/**
!bbttcc-onboarding/
!bbttcc-onboarding/**
!bbttcc-radiation/
!bbttcc-radiation/**
!bbttcc-raid/
!bbttcc-raid/**
!bbttcc-sorting-engine/
!bbttcc-sorting-engine/**
!bbttcc-structures/
!bbttcc-structures/**
!bbttcc-territory/
!bbttcc-territory/**
!bbttcc-tikkun/
!bbttcc-tikkun/**
!bbttcc-travel/
!bbttcc-travel/**
!bbttcc-world/
!bbttcc-world/**
!surge-powers/
!surge-powers/**

# Allow root docs if added later
!README.md
!CHANGELOG.md

# macOS junk
.DS_Store

# ── Re-exclude churn INSIDE the allowed modules ───────────────────────────
# ⚠ Order matters. The `!bbttcc-*/**` negations above re-include *everything*
# under each module, which silently overrode the equivalent rules in the ROOT
# .gitignore (a deeper .gitignore wins for files beneath it). These have to be
# restated here, after the negations, to actually take effect.
# NOTE: `packs/_source/**.json` is deliberately NOT matched — that is authored
# pack source and belongs in the repo.

# Migration snapshots and local backups
**/.backup-*/
**/packs-backup-*/
**/items.bak-*/
**/items-broken-*/
**/*.zip
**/*.tar
**/*.tar.gz
**/*.tgz

# LevelDB pack runtime artifacts — Foundry rotates these on every compendium
# access; they churn constantly and carry no source signal.
**/packs/**/CURRENT
**/packs/**/LOCK
**/packs/**/LOG
**/packs/**/LOG.old
**/packs/**/MANIFEST-*
**/packs/**/*.log
**/packs/**/*.ldb

# Python bytecode
**/__pycache__/
**/*.pyc
