<div class="gottgait-console-root" data-tour="story.root">

  <header class="gottgait-console-header" data-tour="story.header">
    <h2 data-tooltip="{{bbttccTip 'story' 'console'}}">Mal’s GOTTGAIT Story Console</h2>

<div class="gottgait-console-filters" data-tour="story.filters">
  <div class="gottgait-filter" data-tooltip="{{bbttccTip 'story' 'filterQuest'}}">
    <label>Quest</label>
    <select name="filterQuest">
      {{selectOptions questOptions selected=filters.questId}}
    </select>
  </div>

  <div class="gottgait-filter" data-tooltip="{{bbttccTip 'story' 'filterTurn'}}">
    <label>Turn</label>
    <select name="filterTurn">
      {{selectOptions turnOptions selected=filters.turn}}
    </select>
  </div>
</div>

    <p class="gottgait-console-hint">
      <em>“Press buttons, ruin timelines, look confident.” — Mal</em>
    </p>
  </header>

  <div class="gottgait-console-body">
    <div class="gottgait-console-groups" data-tour="story.groups">
      {{#each groups as |group|}}
        <section class="gottgait-group"{{#if group.tour}} data-tour="{{group.tour}}"{{/if}}>
          <h3 class="gottgait-group-title"{{#if group.tip}} data-tooltip="{{group.tip}}"{{/if}}>{{group.label}}</h3>
          <p class="gottgait-group-desc">{{group.description}}</p>

          <ul class="gottgait-beat-list">
            {{#each group.beats as |beat|}}
              <li class="gottgait-beat-row">
                <button type="button"
                        class="gottgait-beat-button"
                        data-action="beat"
                        data-beat="{{beat.key}}"
                        {{#if beat.tour}}data-tour="{{beat.tour}}"{{/if}}
                        {{#if beat.tip}}data-tooltip="{{beat.tip}}"{{/if}}>
                  {{beat.label}}
                </button>
              </li>
            {{/each}}
          </ul>
        </section>
      {{/each}}
    </div>  </div>

</div>
