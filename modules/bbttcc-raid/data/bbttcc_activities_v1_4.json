        },
        "effects": {
          "text": "Screen your own siege's supply convoy. Adds one escort pip; each pip cancels one enemy interdiction at the next strategic tick and deters defender sorties (escort-protected hexes inflict heavier sortie casualties on the defender). Played by the besieger or a supporter. Target the siege's supply-road hex or the besieged hex."
        },
        "minFactionTier": 1,
        "activityKey": "escort_supply_line",
        "siegeThreatVector": true
      }
    }
  },
