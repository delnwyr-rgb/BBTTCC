  "lyrenn": {
    "town": "Lyrenn",
    "hexAliases": ["lyrenn"],
    "hubs": {
      "ring": { "sceneName": "Lyrenn Ring Map", "label": "Lyrenn · The Green Ring", "refWidth": 16800, "refHeight": 9900 },
