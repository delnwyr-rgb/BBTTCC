          ]
        }
      ]
    },

    {
      "index": 7,
      "sefirah": { "hebrew": "Netzach", "english": "Endurance" },
      "pillar": "mercy",
      "station": "Political Philosophy",
      "outputCategory": "philosophy",
      "outputResolvedBy": "resolvePhilosophy",
