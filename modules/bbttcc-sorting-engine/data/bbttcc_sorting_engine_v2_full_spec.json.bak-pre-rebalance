        {
          "id": "Ch1",
          "axis": "metaphysical frame",
          "prompt": "A stranger asks you for help. No story attached. What's your default?",
          "answers": [
            { "key": "A", "text": "You give, then sort it out later. The help first. The questions never.",
              "tags": { "compassion": 2, "sacrifice": 1, "chesed_signal": 2, "mercy": 1 } },
            { "key": "B", "text": "You invite them in. Strangers become kin fast in your circle.",
              "tags": { "kinship": 2, "speech": 1, "chesed_signal": 2 } },
            { "key": "C", "text": "You assess first. A moment's read, then a decision. Help the right ones.",
              "tags": { "study": 1, "discipline": 1, "chesed_signal": 1, "mercy": 1 } },
            { "key": "D", "text": "You decline. Not from cruelty — from a knowledge that you can't save everyone.",
              "tags": { "independence": 2, "severity": 1, "sorrow": 1, "chesed_signal": 1 } }
          ]
        },
        {
          "id": "Ch2",
          "axis": "lived consequence",
          "prompt": "Something breaks. Fast. Who's the first person you reach for?",
          "answers": [
            { "key": "A", "text": "Your crew. You built a circle for exactly this reason.",
              "tags": { "kinship": 2, "speech": 1, "chesed_signal": 2 } },
            { "key": "B", "text": "Nobody. You handle your own emergencies. You always have.",
              "tags": { "independence": 2, "risk": 1, "severity": 1 } },
            { "key": "C", "text": "Your elder. Someone higher up the chain whose judgment you trust.",
              "tags": { "hierarchy": 2, "faith": 1, "chesed_signal": 1 } },
            { "key": "D", "text": "A stranger. You go to whoever's closest and you figure it out together.",
              "tags": { "risk": 2, "compassion": 1, "chesed_signal": 1 } }
          ]
        }
      ]
    },

    {
      "index": 5,
      "sefirah": { "hebrew": "Gevurah", "english": "Severity" },
      "pillar": "severity",
      "station": "Path",
      "outputCategory": "class",
      "outputResolvedBy": "resolveClass",
