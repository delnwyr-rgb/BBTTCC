      "pillar": "middle",
      "station": "Sephirotic Alignment",
      "outputCategory": "alignment",
      "outputResolvedBy": "resolveAlignment",
      "outputIsExplicit": false,
      "_uxNote": "Yesod's quiz answers contribute heavy sefirot signals — the highest signal across all 20 questions wins the alignment. Mock-side: still designer-decision whether to keep the bloom-all-ten visualization during the questions or drop it now that this isn't a picker.",
      "orientation": "Yesod is the funnel. Everything above has to pass through here before it touches earth. This is where the descent stops. Look back at the Tree you've been walking. Which sefirah is the one you actually live on — not the one you'd like to.",
      "questions": [
        {
          "id": "Y1",
          "axis": "metaphysical frame",
          "prompt": "Picture your own gravitational center. An image arrives — a shape. What is it?",
          "answers": [
            { "key": "A", "text": "A sun. Warm. Generative. What you give radiates outward without subtracting.",
              "tags": { "compassion": 2, "tiphareth_signal": 2, "yesod_signal": 2, "faith": 1 } },
            { "key": "B", "text": "A root. Deep. Quiet. Older than you. It holds whether or not you remember it.",
              "tags": { "discipline": 1, "faith": 2, "malkuth_signal": 2, "yesod_signal": 2 } },
            { "key": "C", "text": "A blade. Precise. Useful. Not decorative. It cuts what needs cutting and rests clean.",
