  "stations": [
    {
      "index": 1,
      "sefirah": { "hebrew": "Keter", "english": "Crown" },
      "pillar": "middle",
      "station": "Archetype",
      "outputCategory": "archetype",
      "outputResolvedBy": "resolveArchetype",
      "outputIsExplicit": false,
      "orientation": "Keter is the Crown — the place the soul came from before it was a soul. You don't reach for Keter. It reached for you, back when you had no hands. It remembers why.",
      "questions": [
        {
          "id": "K1",
          "axis": "metaphysical frame",
          "prompt": "Before the flesh, before the name — the call came. What shape did it have?",
          "answers": [
            { "key": "A", "text": "A summons. Someone needed something done and you were the one who showed up.",
              "tags": { "hierarchy": 2, "service": 1, "keter_signal": 2, "speech": 1 } },
            { "key": "B", "text": "A debt. Something was owed. You got sent to pay it.",
              "tags": { "sacrifice": 2, "sorrow": 1, "faith": 1, "keter_signal": 2 } },
            { "key": "C", "text": "A hunger. There was a thing you had to do and nothing else would satisfy you.",
              "tags": { "ambition": 2, "risk": 1, "independence": 1, "keter_signal": 2 } },
            { "key": "D", "text": "A door left open. You walked through it and the door closed behind.",
              "tags": { "faith": 2, "stealth": 1, "dread": 1, "keter_signal": 2 } }
          ]
        },
        {
          "id": "K2",
          "axis": "lived consequence",
          "prompt": "You could have refused. You didn't. What happened when the call reached you?",
          "answers": [
            { "key": "A", "text": "You said yes before you understood what you were saying yes to.",
              "tags": { "risk": 2, "faith": 1, "compassion": 1 } },
            { "key": "B", "text": "You argued. You tried to negotiate terms. You came anyway.",
              "tags": { "speech": 2, "independence": 1, "severity": 1 } },
            { "key": "C", "text": "You grieved. Something was being asked that cost more than it should have.",
              "tags": { "sorrow": 2, "sacrifice": 1, "faith": 1 } },
            { "key": "D", "text": "You studied it. You wanted to know the rules of what you were agreeing to.",
              "tags": { "study": 2, "discipline": 1, "faith": 1 } }
          ]
        }
      ]
    },

    {
      "index": 2,
      "sefirah": { "hebrew": "Chokhmah", "english": "Wisdom" },
      "pillar": "mercy",
      "station": "Ancestries",
      "outputCategory": "ancestry",
      "outputResolvedBy": "resolveAncestry",
      "outputIsExplicit": false,
      "orientation": "Chokhmah is the flash, not the knowledge. The primordial yes, before the yes is understood. Your body gets its first draft here — pulled out of bloodlines that remember what your body has already forgotten.",
      "questions": [
        {
          "id": "C1",
          "axis": "metaphysical frame",
          "prompt": "Knowing is older than knowledge. When a knowing arrives in you, where does it come from?",
          "answers": [
            { "key": "A", "text": "Your hands know before your head does. You reach without thinking.",
              "tags": { "violence": 1, "risk": 1, "chokhmah_signal": 2, "independence": 1 } },
            { "key": "B", "text": "A pattern snaps into place all at once. Suddenly the whole shape is visible.",
              "tags": { "study": 2, "chokhmah_signal": 2, "faith": 1 } },
            { "key": "C", "text": "Someone's face tells you. You read skin and weather and tone better than text.",
              "tags": { "speech": 1, "compassion": 2, "chokhmah_signal": 2 } },
            { "key": "D", "text": "The place tells you. You feel the room before you walk into it.",
              "tags": { "stealth": 2, "faith": 1, "chokhmah_signal": 2, "dread": 1 } }
          ]
        },
        {
          "id": "C2",
          "axis": "lived consequence",
          "prompt": "Your body remembers things your mind hasn't been told. What does it remember best?",
          "answers": [
            { "key": "A", "text": "Weather, geography, the road. Your feet find their way in terrain you've never seen.",
              "tags": { "stealth": 2, "independence": 1, "malkuth_signal": 1 } },
            { "key": "B", "text": "How to hold a weapon. The weight, the grip, the swing — it's already in you.",
              "tags": { "violence": 2, "risk": 1, "gevurah_signal": 1 } },
            { "key": "C", "text": "Ritual — a gesture, a posture, a phrase. It surfaces without your choosing.",
              "tags": { "ritual": 2, "faith": 1, "binah_signal": 1 } },
            { "key": "D", "text": "Silence. How to sit in a room and not fill it. How to wait.",
              "tags": { "discipline": 2, "sorrow": 1, "yesod_signal": 1 } }
          ]
        }
      ]
    },

    {
      "index": 3,
      "sefirah": { "hebrew": "Binah", "english": "Understanding" },
      "pillar": "severity",
      "station": "Heritages",
      "outputCategory": "heritage",
      "outputResolvedBy": "player_pick_filtered_by_ancestry",
      "outputIsExplicit": true,
      "_resolverNote": "Per designer 2026-04-23 (Option B): engine does NOT resolve heritage. Binah's quiz still feeds the trait pool like every other sefirah, but the station's OUTPUT is an explicit player pick at the suggested-build review screen — heritage dropdown filtered by the resolved ancestry's family. Every canonical ancestry now has heritages (27 total across 8 ancestries) so no skip-condition needed.",
      "_explicitPickShape": "Player picks one heritage from the heritages whose family matches the resolver's ancestry output.",
      "orientation": "Understanding — the womb that receives the flash of Chokhmah and gives it structure. Binah is where the undifferentiated becomes differentiated, where seed becomes shape. Your body has roots; Binah is where a people's language, lessons, and ways poured into that body to make it a spirit you recognize.",
      "questions": [
        {
          "id": "B1",
          "axis": "metaphysical frame",
          "prompt": "Your spirit was shaped by hands. What were those hands like?",
          "answers": [
            { "key": "A", "text": "Strict. Every rule meant. Every rule enforced. You knew where the edges were.",
              "tags": { "severity": 2, "discipline": 1, "hierarchy": 1, "binah_signal": 2 } },
            { "key": "B", "text": "Warm. Loud. Overflowing. You never had to wonder if you were wanted.",
              "tags": { "compassion": 2, "kinship": 2, "binah_signal": 2 } },
            { "key": "C", "text": "Distant. You raised yourself around the edges of people too busy to see you.",
              "tags": { "independence": 2, "sorrow": 1, "stealth": 1, "binah_signal": 2 } },
            { "key": "D", "text": "Chaotic. You learned to read rooms because the mood changed fast.",
              "tags": { "stealth": 1, "speech": 1, "dread": 1, "binah_signal": 2, "risk": 1 } }
          ]
        },
        {
          "id": "B2",
          "axis": "lived consequence",
          "prompt": "Whatever raised you left something inside that you can't easily put down. What is it?",
          "answers": [
            { "key": "A", "text": "Discipline. A habit of cutting your own excess before someone else does.",
              "tags": { "discipline": 2, "severity": 1, "gevurah_signal": 1 } },
            { "key": "B", "text": "Suspicion. You assume the worst about why people are being nice.",
              "tags": { "dread": 1, "independence": 2, "stealth": 1 } },
            { "key": "C", "text": "A faith. Something larger that you pray or curse at in bad moments.",
              "tags": { "faith": 2, "ritual": 1, "tiphareth_signal": 1 } },
            { "key": "D", "text": "A grief. Something old that rides quiet in your chest until something stirs it.",
              "tags": { "sorrow": 2, "sacrifice": 1, "hod_signal": 1 } }
          ]
        }
      ]
    },

    {
      "index": 4,
      "sefirah": { "hebrew": "Chesed", "english": "Mercy" },
      "pillar": "mercy",
      "station": "Awesome Crew",
      "outputCategory": "crew",
      "outputResolvedBy": "resolveCrew",
      "outputIsExplicit": false,
      "orientation": "Chesed is the hand that keeps giving — Mercy, unbound. Its failure mode is generosity that drowns. This is where you stop counting kin by blood and start counting by choice.",
