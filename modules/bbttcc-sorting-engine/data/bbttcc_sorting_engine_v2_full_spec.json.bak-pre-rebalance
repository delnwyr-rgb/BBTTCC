            { "key": "A", "text": "Knowledge. The kind that can't be taken — only given. You'd bend anything to learn it.",
              "tags": { "study": 2, "faith": 1, "hod_signal": 2, "ritual": 1 } },
            { "key": "B", "text": "Power. Actual operative power, not the performance of it. You'd kneel and mean it.",
              "tags": { "ambition": 2, "hierarchy": 1, "hod_signal": 1, "ritual": 1 } },
            { "key": "C", "text": "Belonging. The door into a body of people who see each other. You'd kneel for that.",
              "tags": { "kinship": 2, "sacrifice": 1, "hod_signal": 1, "compassion": 1 } },
            { "key": "D", "text": "Release. You'd kneel to lay something down. Grief, maybe. A debt. A name.",
              "tags": { "sorrow": 2, "sacrifice": 1, "hod_signal": 2, "faith": 1 } }
          ]
        },
        {
          "id": "H2",
          "axis": "lived consequence",
          "prompt": "You suspect something true that you can't yet prove. Which of these is most yours?",
          "answers": [
            { "key": "A", "text": "That the world is patterned and the pattern has a name you don't yet know.",
              "tags": { "faith": 2, "study": 1, "hod_signal": 2, "ritual": 1 } },
            { "key": "B", "text": "That you can become something other than what you are. The door is there if you find it.",
              "tags": { "ambition": 2, "faith": 1, "hod_signal": 1, "independence": 1 } },
            { "key": "C", "text": "That the dead speak and some of us can hear them. Some of us do hear them.",
              "tags": { "faith": 1, "sorrow": 2, "hod_signal": 2, "dread": 1 } },
            { "key": "D", "text": "That the future is already written and the writing can be read by the right eye.",
              "tags": { "study": 2, "faith": 1, "hod_signal": 2, "stealth": 1 } }
          ]
        }
      ]
    },

    {
      "index": 9,
