              "tags": { "kinship": 2, "faith": 1, "tiphareth_signal": 2, "sorrow": 1 } },
            { "key": "B", "text": "A text. A line you've memorized. You say it under your breath before hard things.",
              "tags": { "study": 2, "ritual": 1, "tiphareth_signal": 2, "faith": 1 } },
            { "key": "C", "text": "A practice. A body thing. You breathe, or posture, or move a specific way.",
