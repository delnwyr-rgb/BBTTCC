      "orientation": "Netzach is the fire that refuses to go out. Victory through not stopping. The will that outlasts what tried to break it. Here you name the cause that won't let you sit back down.",
      "questions": [
        {
          "id": "N1",
          "axis": "metaphysical frame",
          "prompt": "Something in you refuses to stop. What is the refusal about?",
          "answers": [
            { "key": "A", "text": "Justice. Someone, somewhere, is owed something they aren't getting.",
              "tags": { "speech": 2, "severity": 1, "netzach_signal": 2, "mercy": 1 } },
            { "key": "B", "text": "Your people. The cause is a set of faces. You'd burn a world before they did.",
              "tags": { "kinship": 2, "violence": 1, "sacrifice": 1, "netzach_signal": 2 } },
            { "key": "C", "text": "A place. A patch of ground you know by its smell. You protect that.",
              "tags": { "discipline": 1, "faith": 1, "netzach_signal": 2, "malkuth_signal": 1 } },
            { "key": "D", "text": "A memory. Something that was supposed to be. You're still making the world into it.",
              "tags": { "sorrow": 2, "ambition": 1, "netzach_signal": 2, "faith": 1 } }
          ]
        },
        {
          "id": "N2",
          "axis": "lived consequence",
          "prompt": "When walking is the hardest thing — what keeps you walking?",
          "answers": [
            { "key": "A", "text": "Anger, in small controlled portions. Banked, not spent. The heat outlasts the storm.",
              "tags": { "severity": 2, "discipline": 1, "netzach_signal": 1, "violence": 1 } },
            { "key": "B", "text": "Hope. Real hope, bruised but functioning. You still believe the work matters.",
              "tags": { "faith": 2, "compassion": 1, "netzach_signal": 1 } },
            { "key": "C", "text": "Habit. You've been doing this so long the question of stopping isn't available.",
              "tags": { "discipline": 2, "ritual": 1, "netzach_signal": 1 } },
            { "key": "D", "text": "A promise. You told someone you would. That alone is enough.",
              "tags": { "sacrifice": 2, "faith": 1, "kinship": 1 } }
          ]
        }
      ]
    },

    {
      "index": 8,
      "sefirah": { "hebrew": "Hod", "english": "Splendor" },
