        },
        {
          "id": "G2",
          "axis": "lived consequence",
          "prompt": "Your discipline has a source. When you trace the line back, what's at the end of it?",
          "answers": [
            { "key": "A", "text": "Fear. Something bad will happen if you go slack. You know this precisely.",
              "tags": { "dread": 2, "discipline": 1, "gevurah_signal": 1 } },
            { "key": "B", "text": "Honor. A promise made — to yourself, to the dead, to a principle — that you keep.",
              "tags": { "faith": 2, "discipline": 1, "hierarchy": 1, "gevurah_signal": 1 } },
            { "key": "C", "text": "Necessity. Nothing high-minded about it. Discipline works. Undiscipline doesn't.",
              "tags": { "discipline": 2, "study": 1, "severity": 1 } },
            { "key": "D", "text": "Love. You're holding yourself sharp for someone who needs you intact.",
              "tags": { "sacrifice": 2, "kinship": 1, "mercy": 1 } }
          ]
        }
      ]
    },

    {
