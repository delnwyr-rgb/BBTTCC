            { "key": "D", "text": "A mirror. Reflective. It holds what's shown to it. It knows itself by what it reflects.",
              "tags": { "study": 2, "binah_signal": 2, "yesod_signal": 2, "stealth": 1 } }
          ]
        },
        {
          "id": "Y2",
          "axis": "lived consequence",
          "prompt": "Your foundation has stayed. Something keeps it from shaking apart. What does?",
          "answers": [
            { "key": "A", "text": "People. Specific people whose presence makes the ground feel solid.",
              "tags": { "kinship": 2, "chesed_signal": 1, "yesod_signal": 2, "faith": 1 } },
            { "key": "B", "text": "Place. A piece of geography — a room, a road, a body of water. You anchor there.",
              "tags": { "faith": 1, "malkuth_signal": 2, "yesod_signal": 2, "discipline": 1 } },
            { "key": "C", "text": "Practice. A daily thing. A movement or a phrase or a breath. The practice holds.",
              "tags": { "ritual": 2, "discipline": 1, "yesod_signal": 2, "netzach_signal": 1 } },
            { "key": "D", "text": "Silence. A quiet you return to. When it goes away you feel the shake. When it's back, steady.",
              "tags": { "independence": 2, "study": 1, "yesod_signal": 2, "binah_signal": 1 } }
          ]
        }
      ]
    },

    {
      "index": 10,
      "sefirah": { "hebrew": "Malkuth", "english": "Kingdom" },
      "pillar": "middle",
      "station": "Faculties",
      "outputCategory": "faculties",
      "outputResolvedBy": "explicit_allocation",
      "outputIsExplicit": true,
      "_explicitNote": "Quiz answers feed the trait pool like any other sefirah. The station's OUTPUT is explicit player allocation — distribute starting array [5,4,3,3,2,2] across the 6 RFI faculties. Engine does NOT resolve the allocation, but does use Malkuth's quiz answers to suggest a distribution shape (front-loaded body? balanced? front-loaded mind?) on the suggested-build review screen.",
      "explicitAllocationShape": {
        "startingArray": [5, 4, 3, 3, 2, 2],
        "faculties": ["violence", "intrigue", "presence", "body", "mind", "soul"],
        "rule": "each value used exactly once"
      },
      "orientation": "Malkuth is where the soul hits the ground. Kingdom. Presence. Everything above becomes flesh here. Body that walks, hand that grips, voice that lives in dirt and bread and heartbeat. Descent ends. Life begins.",
      "questions": [
        {
