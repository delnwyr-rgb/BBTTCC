<section class="bbttcc-hex-config">
  <style>
  /* Hex Chrome skin for Bad Eden Hex Configuration */
  .bbttcc-hex-config {
    padding: 0.75rem 0.9rem 0.9rem;
    font-family: Helvetica, Arial, sans-serif;
    font-size: 12px;
    color: #e5e7eb;
    background:
      radial-gradient(circle at 0 0, rgba(148,163,184,0.18), transparent 55%),
      radial-gradient(circle at 100% 0, rgba(56,189,248,0.18), transparent 55%),
      radial-gradient(circle at 0 100%, rgba(147,51,234,0.18), transparent 60%),
      linear-gradient(145deg, rgba(15,23,42,0.98), rgba(15,23,42,0.96));
    border-radius: 0.9rem;
    box-shadow:
      0 0 0 1px rgba(15,23,42,0.95),
      0 18px 32px rgba(15,23,42,0.9);
    box-sizing: border-box;
  }
  .bbttcc-hex-config header.flexrow {
    gap: 0.75rem;
    align-items: center;
    margin-bottom: 0.6rem;
    padding: 0.4rem 0.55rem 0.45rem;
    border-radius: 0.75rem;
    background: linear-gradient(135deg, rgba(15,23,42,0.98), rgba(30,64,175,0.98));
    border: 1px solid rgba(59,130,246,0.8);
    box-shadow:
      0 0 0 1px rgba(15,23,42,0.9),
      0 0 18px rgba(59,130,246,0.45);
  }
  .bbttcc-hex-config header.flexrow h2 {
    margin: 0;
    font-size: 1.05rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
  }
  .bbttcc-hex-config header.flexrow small { font-size: 11px; opacity: 0.85; }

  /* ── Top tabs ─────────────────────────────────────────────── */
  .bbttcc-hex-config .ft-hexcfg-tabs {
    display: flex;
    gap: 0.35rem;
    margin-bottom: 0.75rem;
    padding: 0.3rem 0.35rem;
    border-radius: 0.75rem;
    border: 1px solid rgba(55,65,81,0.95);
    background: linear-gradient(160deg, rgba(15,23,42,0.98), rgba(15,23,42,1));
    box-shadow: 0 0 0 1px rgba(15,23,42,0.9);
  }
  .bbttcc-hex-config .ft-hexcfg-tab {
    flex: 1 1 auto;
    padding: 0.35rem 0.6rem;
    border-radius: 0.5rem;
    border: 1px solid transparent;
    background: transparent;
    color: #94a3b8;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    cursor: pointer;
    line-height: 1.2;
    white-space: nowrap;
  }
  .bbttcc-hex-config .ft-hexcfg-tab:hover {
    color: #e5e7eb;
    border-color: rgba(59,130,246,0.45);
    box-shadow: none;
  }
  .bbttcc-hex-config .ft-hexcfg-tab.active {
    color: #e5e7eb;
    border-color: rgba(59,130,246,0.8);
    background: linear-gradient(135deg, rgba(30,64,175,0.55), rgba(15,23,42,0.9));
    box-shadow: 0 0 12px rgba(59,130,246,0.35);
  }
  .bbttcc-hex-config .ft-hexcfg-tab[data-ft-tab="gm"].active {
    border-color: rgba(212,163,95,0.8);
    background: linear-gradient(135deg, rgba(146,94,28,0.5), rgba(15,23,42,0.9));
    box-shadow: 0 0 12px rgba(212,163,95,0.3);
  }

  /* Panels: one visible at a time, but ALL stay in the DOM so the Save
     button's FormData sweep still reads every field on every tab. */
  .bbttcc-hex-config .grid { display: block; max-width: 100%; }
  .bbttcc-hex-config .col { min-width: 0; }
  .bbttcc-hex-config .ft-hexcfg-panel { display: none; }
  .bbttcc-hex-config .ft-hexcfg-panel.active { display: block; }

  .bbttcc-hex-config fieldset {
    border-radius: 0.75rem;
    border: 1px solid rgba(55,65,81,0.95);
    padding: 0.6rem 0.7rem 0.65rem;
    min-width: 0;
    background:
      radial-gradient(circle at 0 0, rgba(30,64,175,0.26), transparent 60%),
      radial-gradient(circle at 100% 100%, rgba(147,51,234,0.26), transparent 55%),
      linear-gradient(160deg, rgba(15,23,42,0.98), rgba(15,23,42,1));
    box-shadow:
      0 0 0 1px rgba(15,23,42,0.9),
      0 8px 18px rgba(15,23,42,0.9);
  }
  .bbttcc-hex-config legend {
    padding: 0 0.25rem;
    opacity: 0.9;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #cbd5f5;
  }

  .bbttcc-hex-config .form-group { margin-bottom: 0.55rem; }
  .bbttcc-hex-config label {
    display: block;
    font-weight: 600;
    margin-bottom: 0.2rem;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #cbd5f5;
  }

  .bbttcc-hex-config input[type="text"],
  .bbttcc-hex-config input[type="number"],
  .bbttcc-hex-config select,
  .bbttcc-hex-config textarea {
    width: 100%;
    box-sizing: border-box;
    font-size: 12px;
    padding: 0.25rem 0.35rem;
    border-radius: 0.4rem;
    border: 1px solid rgba(55,65,81,0.95);
    background-color: rgba(15,23,42,0.92);
    color: #e5e7eb;
  }
  .bbttcc-hex-config textarea { min-height: 72px; resize: vertical; }
  .bbttcc-hex-config input:focus,
  .bbttcc-hex-config select:focus,
  .bbttcc-hex-config textarea:focus {
    outline: none;
    border-color: rgba(59,130,246,0.9);
    box-shadow: 0 0 0 1px rgba(59,130,246,0.7);
  }
  .bbttcc-hex-config .hint { margin: 0.25rem 0 0; font-size: 10px; opacity: 0.8; }
  .bbttcc-hex-config .row { display: flex; align-items: center; gap: 0.5rem; }
  .bbttcc-hex-config .checkbox { display: flex; align-items: center; gap: 0.4rem; font-size: 11px; }
  .bbttcc-hex-config .checkbox + .checkbox { margin-top: 0.15rem; }
  .bbttcc-hex-config input[type="checkbox"] { transform: scale(1.05); }
  .bbttcc-hex-config + .sheet-footer { display: none !important; }
  </style>

  <header class="flexrow">
    <h2 class="flex1">Bad Eden Hex Configuration</h2>
    {{#if createdAt}}<small class="flex0" title="Created">{{createdAt}}</small>{{/if}}
  </header>

  <nav class="ft-hexcfg-tabs">
    <button type="button" class="ft-hexcfg-tab active" data-ft-tab="overview">Overview</button>
    <button type="button" class="ft-hexcfg-tab" data-ft-tab="resources">Modifiers &amp; Resources</button>
    <button type="button" class="ft-hexcfg-tab" data-ft-tab="leylines">Leylines</button>
    {{#if isGM}}<button type="button" class="ft-hexcfg-tab" data-ft-tab="gm">GM Overrides</button>{{/if}}
  </nav>

  <section class="grid">
    <!-- TAB: OVERVIEW -->
    <div class="col ft-hexcfg-panel active" data-ft-tab-panel="overview">
      <div class="form-group">
        <label>Name</label>
        <input type="text" name="{{#if namePath}}{{namePath}}{{else}}name{{/if}}" value="{{name}}">
      </div>

      <div class="form-group">
        <label>Owner</label>
        <select name="{{#if ownerPath}}{{ownerPath}}{{else}}factionId{{/if}}">
          <option value="">Unclaimed</option>
          {{#each ownerList}}
            <option value="{{id}}" {{#if (bbttcc_eq ../ownerId id)}}selected{{/if}}>{{name}}</option>
          {{/each}}
        </select>
        <p class="hint">Choose a Faction to claim this hex, or leave Unclaimed.</p>
      </div>

      <div class="form-group">
        <label>Status</label>
        <select name="{{#if statusPath}}{{statusPath}}{{else}}status{{/if}}">
          <option value="unclaimed" {{#if (bbttcc_eq status "unclaimed")}}selected{{/if}}>Unclaimed</option>
          <option value="contested" {{#if (bbttcc_eq status "contested")}}selected{{/if}}>Contested</option>
          <option value="occupied" {{#if (bbttcc_eq status "occupied")}}selected{{/if}}>Occupied</option>
          <option value="liberated" {{#if (bbttcc_eq status "liberated")}}selected{{/if}}>Liberated</option>
        </select>
      </div>

      <div class="form-group">
        <label>Type</label>
        <select name="{{#if typePath}}{{typePath}}{{else}}type{{/if}}">
          <option value="settlement" {{#if (bbttcc_eq type "settlement")}}selected{{/if}}>Settlement</option>
          <option value="fortress" {{#if (bbttcc_eq type "fortress")}}selected{{/if}}>Fortress</option>
          <option value="mine" {{#if (bbttcc_eq type "mine")}}selected{{/if}}>Mine</option>
          <option value="farm" {{#if (bbttcc_eq type "farm")}}selected{{/if}}>Farm</option>
          <option value="port" {{#if (bbttcc_eq type "port")}}selected{{/if}}>Port</option>
          <option value="factory" {{#if (bbttcc_eq type "factory")}}selected{{/if}}>Factory</option>
          <option value="research" {{#if (bbttcc_eq type "research")}}selected{{/if}}>Research Facility</option>
          <option value="temple" {{#if (bbttcc_eq type "temple")}}selected{{/if}}>Temple</option>
          <option value="wilderness" {{#if (bbttcc_eq type "wilderness")}}selected{{/if}}>Wilderness</option>
          <option value="wasteland" {{#if (bbttcc_eq type "wasteland")}}selected{{/if}}>Wasteland</option>
          <option value="ruins" {{#if (bbttcc_eq type "ruins")}}selected{{/if}}>Ruins</option>
        </select>
      </div>

      <div class="form-group">
        <label>Size</label>
        <select name="{{#if sizePath}}{{sizePath}}{{else}}size{{/if}}">
          <option value="none" {{#if (bbttcc_eq size "none")}}selected{{/if}}>None (×0.0)</option>
          <option value="outpost" {{#if (bbttcc_eq size "outpost")}}selected{{/if}} {{#if (bbttcc_eq size "small")}}selected{{/if}}>Outpost (×0.5)</option>
          <option value="village" {{#if (bbttcc_eq size "village")}}selected{{/if}}>Village (×0.75)</option>
          <option value="town" {{#if (bbttcc_eq size "town")}}selected{{/if}} {{#if (bbttcc_eq size "standard")}}selected{{/if}}>Town (×1.0)</option>
          <option value="city" {{#if (bbttcc_eq size "city")}}selected{{/if}}>City (×1.5)</option>
          <option value="metropolis" {{#if (bbttcc_eq size "metropolis")}}selected{{/if}} {{#if (bbttcc_eq size "large")}}selected{{/if}}>Metropolis (×2.0)</option>
          <option value="megalopolis" {{#if (bbttcc_eq size "megalopolis")}}selected{{/if}}>Megalopolis (×3.0)</option>
        </select>
        <p class="hint">Size affects resource multiplier (0.5× → 3.0×) and contributes to Defense at larger tiers.</p>
      </div>

      <div class="form-group">
        <label>Population</label>
        <select name="{{#if populationPath}}{{populationPath}}{{else}}population{{/if}}">
          <option value="uninhabited" {{#if (bbttcc_eq population "uninhabited")}}selected{{/if}}>Uninhabited (0)</option>
          <option value="low" {{#if (bbttcc_eq population "low")}}selected{{/if}}>Low</option>
          <option value="medium" {{#if (bbttcc_eq population "medium")}}selected{{/if}}>Medium</option>
          <option value="high" {{#if (bbttcc_eq population "high")}}selected{{/if}}>High</option>
        </select>
      </div>

      <div class="form-group">
        <label>Integration</label>
        <div class="row" style="align-items:baseline;">
          <div class="flex0"><strong data-ft-integ-progress>{{integrationProgress}} / {{integrationMax}}</strong></div>
          <div class="flex1"><small style="opacity:.85;" data-ft-integ-stage>{{#if integrationStageLabel}}{{integrationStageLabel}}{{else}}—{{/if}}</small></div>
        </div>
        <p class="hint">
          Tracks how far this hex has progressed from untouched wilderness to a fully integrated province.<br/>
          Advanced via raids, resolution outcomes, and strategic activities.
        </p>
      </div>

      <div class="form-group row">
        <label style="margin:0;">Capital</label>
        <input type="checkbox" name="{{#if capitalPath}}{{capitalPath}}{{else}}capital{{/if}}" {{#if capital}}checked{{/if}}>
      </div>

      <div class="form-group">
        <label>Alignment (Sephirot)</label>
        <select name="{{#if sephirotPath}}{{sephirotPath}}{{else}}sephirotUuid{{/if}}">
          <option value="">Neutral</option>
          {{#each sephirotList}}
            <option value="{{uuid}}" {{#if (bbttcc_eq ../sephirotUuid uuid)}}selected{{/if}}>{{name}}</option>
          {{/each}}
        </select>
        <p class="hint">Choose a Sephirot; its bonuses apply automatically (some also grant Defense/Tech).</p>
      </div>

      <div class="form-group">
        <label>Notes</label>
        <textarea name="{{#if notesPath}}{{notesPath}}{{else}}notes{{/if}}" placeholder="Optional GM notes stored on the hex.">{{notes}}</textarea>
      </div>
    </div>

    <!-- TAB: MODIFIERS & RESOURCES -->
    <div class="col ft-hexcfg-panel" data-ft-tab-panel="resources">
      <fieldset class="form-group" data-bbttcc="modifiers" style="margin-bottom:.75rem;">
        <legend>Modifiers</legend>
        <label class="checkbox"><input type="checkbox" name="modifiers" value="Well-Maintained" {{#if (bbttcc_contains modifiers "Well-Maintained")}}checked{{/if}}> <span>Well-Maintained</span></label>
        <label class="checkbox"><input type="checkbox" name="modifiers" value="Fortified" {{#if (bbttcc_contains modifiers "Fortified")}}checked{{/if}}> <span>Fortified</span></label>
        <label class="checkbox"><input type="checkbox" name="modifiers" value="Strategic Position" {{#if (bbttcc_contains modifiers "Strategic Position")}}checked{{/if}}> <span>Strategic Position</span></label>
        <label class="checkbox"><input type="checkbox" name="modifiers" value="Hidden Resources" {{#if (bbttcc_contains modifiers "Hidden Resources")}}checked{{/if}}> <span>Hidden Resources</span></label>
        <label class="checkbox"><input type="checkbox" name="modifiers" value="Loyal Population" {{#if (bbttcc_contains modifiers "Loyal Population")}}checked{{/if}}> <span>Loyal Population</span></label>
        <label class="checkbox"><input type="checkbox" name="modifiers" value="Trade Hub" {{#if (bbttcc_contains modifiers "Trade Hub")}}checked{{/if}}> <span>Trade Hub</span></label>
        <label class="checkbox"><input type="checkbox" name="modifiers" value="Contaminated" {{#if (bbttcc_contains modifiers "Contaminated")}}checked{{/if}}> <span>Contaminated</span></label>
        <label class="checkbox"><input type="checkbox" name="modifiers" value="Damaged Infrastructure" {{#if (bbttcc_contains modifiers "Damaged Infrastructure")}}checked{{/if}}> <span>Damaged Infrastructure</span></label>
        <label class="checkbox"><input type="checkbox" name="modifiers" value="Hostile Population" {{#if (bbttcc_contains modifiers "Hostile Population")}}checked{{/if}}> <span>Hostile Population</span></label>
        <label class="checkbox"><input type="checkbox" name="modifiers" value="Supply Line Vulnerable" {{#if (bbttcc_contains modifiers "Supply Line Vulnerable")}}checked{{/if}}> <span>Supply Line Vulnerable</span></label>
        <label class="checkbox"><input type="checkbox" name="modifiers" value="Difficult Terrain" {{#if (bbttcc_contains modifiers "Difficult Terrain")}}checked{{/if}}> <span>Difficult Terrain</span></label>
        <label class="checkbox"><input type="checkbox" name="modifiers" value="Radiation Zone" {{#if (bbttcc_contains modifiers "Radiation Zone")}}checked{{/if}}> <span>Radiation Zone</span></label>
        <p class="hint">These affect yields (and sometimes Defense/flags). They match the math used by Campaign Overview and the Turn Driver.</p>
      </fieldset>

      <fieldset style="margin-bottom:.75rem;">
        <legend>Resources (per turn)</legend>
        <div class="form-group"><label>Food</label> <input type="number" name="resources.food" value="{{resources.food}}" min="0" step="1"></div>
        <div class="form-group"><label>Materials</label> <input type="number" name="resources.materials" value="{{resources.materials}}" min="0" step="1"></div>
        <div class="form-group"><label>Trade</label> <input type="number" name="resources.trade" value="{{resources.trade}}" min="0" step="1"></div>
        <div class="form-group"><label>Military</label> <input type="number" name="resources.military" value="{{resources.military}}" min="0" step="1"></div>
        <div class="form-group"><label>Knowledge</label> <input type="number" name="resources.knowledge" value="{{resources.knowledge}}" min="0" step="1"></div>
        <p class="hint">Leave all five at <strong>0</strong> to let the system compute effective yields from <em>Type × Size</em> plus Alignment &amp; Modifiers (Population not used yet). This matches the Overview and Turn math.</p>
      </fieldset>

      <fieldset>
        <legend>Save Behavior</legend>
        <label class="checkbox">
          <input type="checkbox" name="manualOverride" {{#if manualOverrideChecked}}checked{{/if}}>
          <span>Manual resource override</span>
        </label>
        <p class="hint">Unchecked → save <em>auto-calculated</em> resources from Type × Size × Alignment + Modifiers (recommended).</p>
      </fieldset>
    </div>

    <!-- TAB: LEYLINES -->
    <div class="col ft-hexcfg-panel" data-ft-tab-panel="leylines">
      <fieldset class="bbttcc-leylines-panel" style="margin-bottom:.75rem;">
        <legend>Leylines</legend>

        <p class="hint" style="margin:.1rem 0 .5rem;">Subtle mythic currents threading the map. Each hex has a Resonance (color), a Flow State (behavior), a Purity axis (Sephirotic ↔ Qliphothic), and an optional Gate for remote adjacency.</p>

        <div class="form-group">
          <label>Primary Resonance</label>
          <select name="leylines.primaryResonance">
            <option value="none"   {{#if (bbttcc_eq leylines.primaryResonance "none")}}selected{{/if}}>None</option>
            <option value="red"    {{#if (bbttcc_eq leylines.primaryResonance "red")}}selected{{/if}}>Red — Mars / Gevurah</option>
            <option value="blue"   {{#if (bbttcc_eq leylines.primaryResonance "blue")}}selected{{/if}}>Blue — Mercury / Hod</option>
            <option value="green"  {{#if (bbttcc_eq leylines.primaryResonance "green")}}selected{{/if}}>Green — Venus / Netzach</option>
            <option value="yellow" {{#if (bbttcc_eq leylines.primaryResonance "yellow")}}selected{{/if}}>Yellow — Sol / Tiferet</option>
            <option value="violet" {{#if (bbttcc_eq leylines.primaryResonance "violet")}}selected{{/if}}>Violet — Luna / Yesod</option>
            <option value="white"  {{#if (bbttcc_eq leylines.primaryResonance "white")}}selected{{/if}}>White — Sephirotic</option>
            <option value="black"  {{#if (bbttcc_eq leylines.primaryResonance "black")}}selected{{/if}}>Black — Qliphothic</option>
          </select>
        </div>

        <details style="margin:.25rem 0 .6rem .25rem; font-size:.92em; opacity:.95;">
          <summary style="cursor:pointer; opacity:.8;">What does each color mean?</summary>
          <table style="width:100%; border-collapse:collapse; margin-top:.4rem;">
            <tbody>
              <tr><td style="padding:.18rem .4rem;"><span style="display:inline-block; width:.85em; height:.85em; border-radius:50%; background:#9aa1a8; vertical-align:middle;"></span> <strong>None</strong></td><td style="padding:.18rem .4rem;">No detectable current. Hex is invisible to most leyline-aware effects.</td></tr>
              <tr><td style="padding:.18rem .4rem;"><span style="display:inline-block; width:.85em; height:.85em; border-radius:50%; background:#d04a4a; vertical-align:middle;"></span> <strong>Red</strong></td><td style="padding:.18rem .4rem;">Mars / Gevurah. Tied to Violence, martial works, and forge-rituals.</td></tr>
              <tr><td style="padding:.18rem .4rem;"><span style="display:inline-block; width:.85em; height:.85em; border-radius:50%; background:#3e8bd6; vertical-align:middle;"></span> <strong>Blue</strong></td><td style="padding:.18rem .4rem;">Mercury / Hod. Tied to Knowledge, signal-craft, and divination.</td></tr>
              <tr><td style="padding:.18rem .4rem;"><span style="display:inline-block; width:.85em; height:.85em; border-radius:50%; background:#5cb85c; vertical-align:middle;"></span> <strong>Green</strong></td><td style="padding:.18rem .4rem;">Venus / Netzach. Tied to growth, Food and Materials yields, and life-rites.</td></tr>
              <tr><td style="padding:.18rem .4rem;"><span style="display:inline-block; width:.85em; height:.85em; border-radius:50%; background:#e5bc24; vertical-align:middle;"></span> <strong>Yellow</strong></td><td style="padding:.18rem .4rem;">Sol / Tiferet. Tied to Trade and gate corridors — the canonical color of a viable leygate hub.</td></tr>
              <tr><td style="padding:.18rem .4rem;"><span style="display:inline-block; width:.85em; height:.85em; border-radius:50%; background:#8b5cb8; vertical-align:middle;"></span> <strong>Violet</strong></td><td style="padding:.18rem .4rem;">Luna / Yesod. Tied to Intrigue, dreams, and the threshold of waking and sleeping mind.</td></tr>
              <tr><td style="padding:.18rem .4rem;"><span style="display:inline-block; width:.85em; height:.85em; border-radius:50%; background:#f4f4f4; border:1px solid #888; vertical-align:middle;"></span> <strong>White</strong></td><td style="padding:.18rem .4rem;">Keter / Sephirotic alignment. Heals Purity over time and resists corruption.</td></tr>
              <tr><td style="padding:.18rem .4rem;"><span style="display:inline-block; width:.85em; height:.85em; border-radius:50%; background:#1a1a1a; border:1px solid #888; vertical-align:middle;"></span> <strong>Black</strong></td><td style="padding:.18rem .4rem;">Qliphothic alignment. Drives Purity toward −5 and corrupts adjacent hexes if untended.</td></tr>
            </tbody>
          </table>
        </details>

        <div class="form-group">
          <label>Flow State</label>
          <select name="leylines.flowState">
            <option value="normal"     {{#if (bbttcc_eq leylines.flowState "normal")}}selected{{/if}}>Normal</option>
            <option value="turbulence" {{#if (bbttcc_eq leylines.flowState "turbulence")}}selected{{/if}}>Turbulence</option>
            <option value="surge"      {{#if (bbttcc_eq leylines.flowState "surge")}}selected{{/if}}>Surge</option>
            <option value="stagnation" {{#if (bbttcc_eq leylines.flowState "stagnation")}}selected{{/if}}>Stagnation</option>
            <option value="inversion"  {{#if (bbttcc_eq leylines.flowState "inversion")}}selected{{/if}}>Inversion</option>
            <option value="fracture"   {{#if (bbttcc_eq leylines.flowState "fracture")}}selected{{/if}}>Fracture</option>
            <option value="seal"       {{#if (bbttcc_eq leylines.flowState "seal")}}selected{{/if}}>Seal</option>
          </select>
        </div>

        <details style="margin:.25rem 0 .6rem .25rem; font-size:.92em; opacity:.95;">
          <summary style="cursor:pointer; opacity:.8;">What does each Flow State do?</summary>
          <table style="width:100%; border-collapse:collapse; margin-top:.4rem;">
            <tbody>
              <tr><td style="padding:.18rem .4rem; white-space:nowrap;"><strong>Normal</strong></td><td style="padding:.18rem .4rem;">Standard conversion of Resources → OP. No drift.</td></tr>
              <tr><td style="padding:.18rem .4rem; white-space:nowrap;"><strong>Turbulence</strong></td><td style="padding:.18rem .4rem;">Erratic current. Conversion penalty; future phenomena rolls possible.</td></tr>
              <tr><td style="padding:.18rem .4rem; white-space:nowrap;"><strong>Surge</strong></td><td style="padding:.18rem .4rem;">Above-baseline output this turn; risks backlash on already-stressed hexes.</td></tr>
              <tr><td style="padding:.18rem .4rem; white-space:nowrap;"><strong>Stagnation</strong></td><td style="padding:.18rem .4rem;">Resources accumulate but conversion is throttled until cleared.</td></tr>
              <tr><td style="padding:.18rem .4rem; white-space:nowrap;"><strong>Inversion</strong></td><td style="padding:.18rem .4rem;">Swaps Violence ↔ SoftPower and Diplomacy ↔ Intrigue at conversion. <em>Fully wired today.</em></td></tr>
              <tr><td style="padding:.18rem .4rem; white-space:nowrap;"><strong>Fracture</strong></td><td style="padding:.18rem .4rem;">Leyline integrity broken. Gates anchored here are unsafe to open until repaired.</td></tr>
              <tr><td style="padding:.18rem .4rem; white-space:nowrap;"><strong>Seal</strong></td><td style="padding:.18rem .4rem;">Hex is leyline-inert. Resonance and charge effects suppressed; immune to gate intrusion.</td></tr>
            </tbody>
          </table>
        </details>

        <div class="form-group">
          <label>Purity (−5…+5)</label>
          <input type="number" name="leylines.purity" value="{{leylines.purity}}" min="-5" max="5" step="1">
          <p class="hint">Drifts each turn: high Darkness corrupts; Sephirotic alignment heals when Darkness is low.</p>
        </div>

        <div class="form-group">
          <label>Memory Charge</label>
          <input type="number" name="leylines.memoryCharge" value="{{leylines.memoryCharge}}" min="0" step="1">
          <p class="hint">Reserved for Stargates / remote adjacency (Tier-gated) and high-level ritual systems.</p>
        </div>

        <hr style="border:none; border-top:1px solid rgba(148,163,184,0.25); margin:.6rem 0 .55rem;"/>

        <div class="bbttcc-gate-block" style="display:block; margin:.25rem 0;">
          <div style="font-weight:600; margin-bottom:.35rem;">Gate (Remote Adjacency)</div>
          <p class="hint" style="margin:0 0 .55rem;">A Leygate links this hex to a remote one for travel/trade pathing. Each hex stores <em>one</em> outgoing target, so a two-way gate needs both ends pointed at each other.</p>

          <div class="bbttcc-gate-grid" style="display:grid; grid-template-columns: 11em 1fr; column-gap:.75rem; row-gap:.6rem; align-items:start;">
            <label style="padding-top:.15rem;">Enabled</label>
            <div>
              <label class="checkbox" style="display:flex; gap:.5rem; align-items:center; margin:0;">
                <input type="checkbox" name="leylines.gate.enabled" {{#if leylines.gate.enabled}}checked{{/if}}>
              </label>
              <p class="hint" style="margin:.2rem 0 0;">When on, Travel/Trade treat the target as adjacent. Leave off to author a dormant gate awaiting a quest unlock.</p>
            </div>

            <label style="padding-top:.4rem;">Target Hex</label>
            <div>
              <select name="leylines.gate.linkHexUuid" style="width:100%;">
                <option value="" {{#if (bbttcc_eq leylines.gate.linkHexUuid "")}}selected{{/if}}>— none —</option>
                {{#if leylineGateOrphanUuid}}
                <option value="{{leylineGateOrphanUuid}}" selected>⚠ Orphan link: {{leylineGateOrphanUuid}}</option>
                {{/if}}
                {{#each leylineHexOptions}}
                <optgroup label="{{this.sceneName}}{{#if this.isCurrent}} (this scene){{/if}}">
                  {{#each this.hexes}}
                  <option value="{{this.uuid}}" {{#if (bbttcc_eq ../../leylines.gate.linkHexUuid this.uuid)}}selected{{/if}}>{{this.name}}</option>
                  {{/each}}
                </optgroup>
                {{/each}}
              </select>
              <p class="hint" style="margin:.2rem 0 0;">Pick the destination hex by name. Same-scene hexes are listed first. Stored as a Foundry UUID under the hood.</p>
            </div>

            <label style="padding-top:.4rem;">Strength</label>
            <div>
              <input type="number" name="leylines.gate.strength" min="0" max="1" step="0.05" value="{{leylines.gate.strength}}" style="width:6em;">
              <p class="hint" style="margin:.2rem 0 0;">0.0 = sputter, 1.0 = pristine. Drives Travel v2 polyline weight and routing weight.</p>
            </div>

            <label style="padding-top:.4rem;">Minimum Faction Tier</label>
            <div>
              <select name="leylines.gate.minFactionTier" style="width:auto; min-width:14em;">
                <option value="T1" {{#if (bbttcc_eq leylines.gate.minFactionTier "T1")}}selected{{/if}} {{#if (bbttcc_eq leylines.gate.minFactionTier "A")}}selected{{/if}}>Tier 1 — Open (any faction)</option>
                <option value="T2" {{#if (bbttcc_eq leylines.gate.minFactionTier "T2")}}selected{{/if}} {{#if (bbttcc_eq leylines.gate.minFactionTier "B")}}selected{{/if}}>Tier 2 — Established</option>
                <option value="T3" {{#if (bbttcc_eq leylines.gate.minFactionTier "T3")}}selected{{/if}} {{#if (bbttcc_eq leylines.gate.minFactionTier "C")}}selected{{/if}}>Tier 3 — Great Power</option>
                <option value="T4" {{#if (bbttcc_eq leylines.gate.minFactionTier "T4")}}selected{{/if}}>Tier 4 — Capital</option>
              </select>
              <p class="hint" style="margin:.2rem 0 0;">Faction must meet or exceed this Tier (read from flags.bbttcc-factions.tier) to traverse. Legacy A/B/C auto-map to T1/T2/T3.</p>
            </div>

            <label style="padding-top:.15rem;">Locked</label>
            <div>
              <label class="checkbox" style="display:flex; gap:.5rem; align-items:center; margin:0;">
                <input type="checkbox" name="leylines.gate.locked" {{#if leylines.gate.locked}}checked{{/if}}>
              </label>
              <p class="hint" style="margin:.2rem 0 0;">Editor-protect this gate's authored values. (Not a quest-lock — to gate-on-quest, leave <em>Enabled</em> off.)</p>
            </div>
          </div>
        </div>
      </fieldset>
    </div>

    {{#if isGM}}
    <!-- TAB: GM OVERRIDES (manual-edit panel injects here) -->
    <div class="col ft-hexcfg-panel" data-ft-tab-panel="gm">
      <p class="hint" data-ft-gm-placeholder>The GM manual-edit panel appears here when <strong>GM Edit Mode</strong> is enabled in the Bad Eden Core (bbttcc-core) settings.</p>
    </div>
    {{/if}}
  </section>
</section>
