<section class="bbttcc-hex-sheet-root" id="bbttcc-hex-sheet">
  <style>
    /* 2026-05-13 — Scroll fix v2. Root takes EXACTLY 100% of its
       container (filling window-content) AND owns the scroll. The
       inner layout can grow taller than the root; when it does, the
       root scrolls internally. */
    .bbttcc-hex-sheet-root{
      height:100%;
      max-height:100%;
      overflow-y:auto;
      overflow-x:hidden;
      box-sizing:border-box;
      padding:10px;
      color:#e5e7eb;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background:
        radial-gradient(circle at 0 0, rgba(148,163,184,0.14), transparent 55%),
        radial-gradient(circle at 100% 0, rgba(224,169,63,0.14), transparent 55%),
        radial-gradient(circle at 0 100%, rgba(176,114,18,0.14), transparent 60%),
        linear-gradient(145deg, rgba(15,23,42,0.98), rgba(15,23,42,0.96));
      border-radius:12px;
    }

    /* Layout grid grows naturally — when its total height exceeds the
       root's height, the root scrolls. The two columns flow side-by-side
       and each can be as tall as needed; the scroll bar appears on the
       root, not the columns. */
    .bbttcc-hex-sheet-root .bbttcc-layout{
      display:grid;
      grid-template-columns: minmax(300px, 360px) minmax(0, 1fr);
      gap:10px;
    }

    .bbttcc-hex-sheet-root .bbttcc-hex-card{
      background: rgba(15,23,42,0.92);
      border:1px solid rgba(55,65,81,0.9);
      border-radius:12px;
      padding:10px;
      box-shadow: 0 0 0 1px rgba(15,23,42,0.65), 0 14px 24px rgba(15,23,42,0.6);
    }

    .bbttcc-hex-sheet-root .bbttcc-hex-title{
      font-size:1.05rem;
      font-weight:800;
      letter-spacing:.12em;
      text-transform:uppercase;
    }

    .bbttcc-hex-sheet-root .bbttcc-muted{ opacity:.82; }

    .bbttcc-hex-sheet-root .bbttcc-pill{
      display:inline-flex;
      align-items:center;
      gap:6px;
      padding:2px 10px;
      border-radius:999px;
      border:1px solid rgba(251,191,36,0.9);
      color:#facc15;
      font-size:.75rem;
      letter-spacing:.12em;
      text-transform:uppercase;
      background: rgba(15,23,42,0.7);
      white-space:nowrap;
    }

    .bbttcc-hex-sheet-root .bbttcc-pill-soft{
      border-color: rgba(148,163,184,0.55);
      color:#e5e7eb;
      background: rgba(2,6,23,0.25);
      font-size:.72rem;
      letter-spacing:.10em;
    }

    .bbttcc-hex-sheet-root .bbttcc-pill-danger{
      border-color: rgba(248,113,113,0.65);
      color:#fecaca;
      background: rgba(127,29,29,0.18);
    }

    .bbttcc-hex-sheet-root .bbttcc-pill-good{
      border-color: rgba(34,197,94,0.65);
      color:#bbf7d0;
      background: rgba(20,83,45,0.18);
    }

    .bbttcc-hex-sheet-root .bbttcc-row{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:10px;
      font-size:.85rem;
      min-width:0;
    }

    /* Base = secondary: dark bronze-edged door-plate (brass reserved for prominent). */
    .bbttcc-hex-sheet-root .bbttcc-btn{
      cursor:pointer;
      border-radius:999px;
      border:1px solid rgba(224,169,63,0.55);
      background: linear-gradient(135deg, rgba(20,16,9,0.98), rgba(40,30,12,0.95));
      color:#e8e2d4;
      padding:4px 10px;
      font-size:.75rem;
      letter-spacing:.12em;
      text-transform:uppercase;
      white-space:nowrap;
    }

    /* Prominent (non-small, non-danger/good) → full brass door-plate. */
    .bbttcc-hex-sheet-root .bbttcc-btn:not(.bbttcc-btn-small):not(.bbttcc-btn-danger):not(.bbttcc-btn-good){
      border:1px solid rgba(255,207,92,0.85);
      background:
        radial-gradient(circle at 0 0, rgba(255,222,140,0.55), transparent 55%),
        linear-gradient(135deg, #e0a82e, #b5740f);
      color:#1a1205;
      font-weight:700;
      text-shadow:0 1px 0 rgba(255,240,200,0.5);
      box-shadow: inset 0 1px 0 rgba(255,245,210,0.55), inset 0 -2px 3px rgba(90,55,5,0.45), 0 1px 2px rgba(0,0,0,0.45);
    }

    .bbttcc-hex-sheet-root .bbttcc-btn:active{ transform: translateY(1px); }

    .bbttcc-hex-sheet-root .bbttcc-btn-small{
      padding:2px 8px;
      font-size:.72rem;
      letter-spacing:.10em;
    }

    .bbttcc-hex-sheet-root .bbttcc-btn-danger{
      border-color: rgba(248,113,113,0.65);
      background: linear-gradient(135deg, rgba(15,23,42,1), rgba(127,29,29,0.95));
    }

    .bbttcc-hex-sheet-root .bbttcc-btn-good{
      border-color: rgba(34,197,94,0.65);
      background: linear-gradient(135deg, rgba(15,23,42,1), rgba(20,83,45,0.95));
    }

    .bbttcc-hex-sheet-root .bbttcc-pane{
      min-height:0;
      display:flex;
      flex-direction:column;
      gap:10px;
    }

    .bbttcc-hex-sheet-root .bbttcc-pane-scroll{
      min-height:0;
      overflow:auto;
      display:flex;
      flex-direction:column;
      gap:10px;
      padding-right:4px;
    }

    .bbttcc-hex-sheet-root .bbttcc-grid{
      display:grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap:6px 12px;
      font-size:.85rem;
    }

    .bbttcc-hex-sheet-root .bbttcc-track{
      letter-spacing:2px;
      font-size:.95rem;
      white-space:nowrap;
    }

    .bbttcc-hex-sheet-root .bbttcc-chiprow{
      display:flex;
      flex-wrap:wrap;
      gap:6px;
      align-items:center;
    }

    .bbttcc-hex-sheet-root .bbttcc-hr{
      border:none;
      border-top:1px solid rgba(148,163,184,0.18);
      margin:8px 0 6px;
    }

    .bbttcc-hex-sheet-root .bbttcc-hex-art{
      position:relative;
      width:100%;
      aspect-ratio: 4 / 3;
      background:
        radial-gradient(circle at 50% 50%, rgba(224,169,63,0.10), transparent 60%),
        linear-gradient(135deg, rgba(2,6,23,0.85), rgba(15,23,42,0.85));
      border:1px solid rgba(55,65,81,0.9);
      border-radius:10px;
      overflow:hidden;
      cursor:pointer;
      display:flex;
      align-items:center;
      justify-content:center;
      margin-bottom:8px;
    }
    .bbttcc-hex-sheet-root .bbttcc-hex-art img{
      width:100%;
      height:100%;
      object-fit:cover;
      display:block;
    }
    .bbttcc-hex-sheet-root .bbttcc-hex-art .bbttcc-hex-art-empty{
      color:#94a3b8;
      text-align:center;
      font-size:.78rem;
      letter-spacing:.10em;
      text-transform:uppercase;
      padding:14px;
    }
    .bbttcc-hex-sheet-root .bbttcc-hex-art:hover{
      border-color: rgba(224,169,63,0.6);
    }

    @media (max-width: 860px){
      .bbttcc-hex-sheet-root .bbttcc-layout{ grid-template-columns: 1fr; }
    }

    /* Dossier tabs */
    .bbttcc-hex-sheet-root .bbttcc-tabs{
      display:flex;
      align-items:center;
      gap:8px;
      margin: 0 0 10px 0;
      padding:6px 8px 6px 6px;
      border:1px solid rgba(148,163,184,0.35);
      border-radius:10px;
      background: rgba(2,6,23,0.55);
    }
    .bbttcc-hex-sheet-root button.bbttcc-tab{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      cursor:pointer;
      border:1px solid rgba(148,163,184,0.55);
      background: linear-gradient(180deg, rgba(30,41,59,0.95), rgba(15,23,42,0.95));
      color:#e5e7eb;
      padding:6px 14px;
      min-width: 100px;
      font-size:.82rem;
      letter-spacing:.12em;
      text-transform:uppercase;
      border-radius:8px;
      font-weight:800;
      box-shadow: 0 1px 0 rgba(148,163,184,0.25) inset;
    }
    .bbttcc-hex-sheet-root button.bbttcc-tab:hover{
      border-color: rgba(224,169,63,0.85);
      color:#bae6fd;
    }
    .bbttcc-hex-sheet-root button.bbttcc-tab.active{
      color:#facc15;
      border-color: rgba(251,191,36,0.95);
      background: linear-gradient(180deg, rgba(180,140,20,0.55), rgba(120,90,10,0.95));
      box-shadow: 0 0 0 1px rgba(251,191,36,0.55), 0 2px 8px rgba(251,191,36,0.18);
    }
    .bbttcc-hex-sheet-root .bbttcc-stage-pill{
      display:inline-flex;
      align-items:center;
      gap:6px;
      padding:2px 10px;
      border-radius:999px;
      border:1px solid rgba(224,169,63,0.65);
      color:#bae6fd;
      background: rgba(2,6,23,0.45);
      font-size:.72rem;
      letter-spacing:.10em;
      text-transform:uppercase;
    }
    .bbttcc-hex-sheet-root .bbttcc-mod-row{
      padding:6px 8px;
      border:1px solid rgba(55,65,81,0.6);
      border-radius:8px;
      background: rgba(15,23,42,0.55);
      margin-bottom:6px;
    }
    .bbttcc-hex-sheet-root .bbttcc-mod-row .bbttcc-mod-name{
      font-weight:700;
      color:#e5e7eb;
      text-transform:capitalize;
    }
    .bbttcc-hex-sheet-root .bbttcc-mod-row .bbttcc-mod-desc{
      opacity:.82;
      font-size:.82rem;
      margin-top:2px;
    }
    .bbttcc-hex-sheet-root .bbttcc-mod-row .bbttcc-mod-meta{
      opacity:.62;
      font-size:.72rem;
      margin-top:2px;
    }
    .bbttcc-hex-sheet-root .bbttcc-prod-table{
      display:grid;
      grid-template-columns: 1fr auto auto auto;
      gap:4px 12px;
      font-size:.84rem;
      align-items:center;
    }
    .bbttcc-hex-sheet-root .bbttcc-prod-table .bbttcc-prod-head{
      opacity:.6;
      font-size:.72rem;
      letter-spacing:.10em;
      text-transform:uppercase;
    }
    .bbttcc-hex-sheet-root .bbttcc-timeline{
      display:flex;
      flex-direction:column;
      gap:6px;
      max-height:340px;
      overflow:auto;
      padding-right:4px;
    }
    .bbttcc-hex-sheet-root .bbttcc-timeline-row{
      display:grid;
      grid-template-columns: auto 1fr auto;
      gap:8px;
      align-items:flex-start;
      padding:6px 8px;
      border-left:2px solid rgba(224,169,63,0.5);
      background: rgba(2,6,23,0.35);
      border-radius:0 8px 8px 0;
    }
    .bbttcc-hex-sheet-root .bbttcc-timeline-row i{
      color:#7dd3fc;
      margin-top:3px;
    }
    .bbttcc-hex-sheet-root .bbttcc-timeline-label{
      font-weight:700;
    }
    .bbttcc-hex-sheet-root .bbttcc-timeline-desc{
      opacity:.8;
      font-size:.8rem;
      margin-top:1px;
    }
    .bbttcc-hex-sheet-root .bbttcc-timeline-meta{
      opacity:.6;
      font-size:.7rem;
      letter-spacing:.06em;
      text-transform:uppercase;
      white-space:nowrap;
    }
    .bbttcc-hex-sheet-root .bbttcc-next-group{
      margin-bottom:8px;
    }
    .bbttcc-hex-sheet-root .bbttcc-next-group h4{
      margin:0 0 4px 0;
      font-size:.78rem;
      letter-spacing:.10em;
      text-transform:uppercase;
      color:#a5b4fc;
    }
    .bbttcc-hex-sheet-root .bbttcc-next-row{
      padding:6px 8px;
      border:1px solid rgba(55,65,81,0.6);
      border-radius:8px;
      background: rgba(15,23,42,0.45);
      margin-bottom:4px;
    }
    .bbttcc-hex-sheet-root .bbttcc-next-row .bbttcc-next-label{
      font-weight:700;
    }
    .bbttcc-hex-sheet-root .bbttcc-next-row .bbttcc-next-detail{
      opacity:.8;
      font-size:.8rem;
      margin-top:2px;
    }
    .bbttcc-hex-sheet-root .bbttcc-next-row .bbttcc-next-acts{
      opacity:.85;
      font-size:.72rem;
      margin-top:4px;
      display:flex;
      flex-wrap:wrap;
      align-items:center;
      gap:4px;
    }
    .bbttcc-hex-sheet-root .bbttcc-next-row .bbttcc-next-acts-label{
      opacity:.55;
      font-style:italic;
      margin-right:4px;
    }
    .bbttcc-hex-sheet-root button.bbttcc-act-pill{
      cursor:pointer;
      border:1px solid rgba(224,169,63,0.7);
      background: linear-gradient(135deg, rgba(15,23,42,1), rgba(176,114,18,0.85));
      color:#bae6fd;
      padding:1px 8px;
      border-radius:999px;
      font-size:.72rem;
      letter-spacing:.06em;
      font-family: inherit;
      font-weight:700;
      text-transform:none;
    }
    .bbttcc-hex-sheet-root button.bbttcc-act-pill:hover{
      color:#fef3c7;
      border-color: rgba(251,191,36,0.95);
      background: linear-gradient(135deg, rgba(15,23,42,1), rgba(120,90,10,0.85));
    }
  </style>

  <div class="bbttcc-layout">

    <aside class="bbttcc-pane bbttcc-hex-card">
      {{#if hexImage}}
        <div class="bbttcc-hex-art" data-action="hex-image-edit" data-tooltip="{{bbttccTip 'hex' 'art'}}" data-tour="hex.art">
          <img src="{{hexImage}}" alt="{{name}}"/>
        </div>
      {{else}}
        {{#if isGM}}
          <div class="bbttcc-hex-art" data-action="hex-image-edit" data-tooltip="{{bbttccTip 'hex' 'art'}}" data-tour="hex.art">
            <div class="bbttcc-hex-art-empty">+ Add Hex Artwork</div>
          </div>
        {{/if}}
      {{/if}}

      <div class="bbttcc-row" style="align-items:baseline;" data-tour="hex.identity">
        <div style="min-width:0;" data-tooltip="{{bbttccTip 'hex' 'identity'}}">
          <div class="bbttcc-hex-title">{{name}}</div>
          <div class="bbttcc-muted">{{size}} {{type}}</div>
        </div>
        <div><span class="bbttcc-pill" data-tooltip="{{bbttccTip 'hex' 'status'}}" data-tour="hex.status">⬢ {{status}}</span></div>
      </div>

      <div class="bbttcc-pane-scroll">
        <div class="bbttcc-hex-card" style="padding:8px 10px;" data-tooltip="{{bbttccTip 'hex' 'owner'}}" data-tour="hex.owner">
          <div class="bbttcc-muted" style="font-size:.8rem;">Owner</div>
          <div style="font-weight:700;">{{ownerName}}</div>
        </div>

        {{!-- Facilities card retired 2026-06-30: facilities were unified with rigs
              (2026-05-07 sprint) and now surface under Holdings below. The legacy
              "Open Builder" entry point is removed. --}}

        {{!-- Holdings Phase A (2026-05-14) — strategic↔tactical bridge.
              Rigs, Bosses, Facilities stationed at this hex. Provides
              defender DC bonuses when this hex is raided AND can be
              deployed as tactical units on bound battle scenes. --}}
        <div class="bbttcc-hex-card bbttcc-holdings-card" style="padding:8px 10px;" data-tour="hex.holdings">
          <div class="bbttcc-row" style="margin-bottom:6px; align-items:center; justify-content:space-between; gap:8px;">
            <div style="font-weight:800; flex:1 1 auto; min-width:0;" data-tooltip="{{bbttccTip 'hex' 'holdings'}}">Holdings</div>
            <div style="display:flex; align-items:center; gap:6px; flex:0 0 auto;">
              <span class="bbttcc-pill bbttcc-pill-soft" data-tooltip="{{bbttccTip 'hex' 'holdingsBonus'}}" data-tour="hex.holdingsBonus" style="color:#fbbf24;">+{{holdings.totalBonus}}</span>
              {{#if isGM}}
                {{#if holdings.hasAny}}
                  <button type="button" class="bbttcc-btn bbttcc-btn-small" data-action="holdings-deploy" data-tooltip="{{bbttccTip 'hex' 'holdingsDeploy'}}" data-tour="hex.holdingsDeploy">🎯 Deploy</button>
                  <button type="button" class="bbttcc-btn bbttcc-btn-small" data-action="holdings-recall" data-tooltip="{{bbttccTip 'hex' 'holdingsRecall'}}" style="opacity:.85;">↩ Recall</button>
                {{/if}}
                <button type="button" class="bbttcc-btn bbttcc-btn-small" data-action="holdings-add" data-tooltip="{{bbttccTip 'hex' 'holdingsStation'}}" data-tour="hex.holdingsStation">＋ Station</button>
              {{/if}}
            </div>
          </div>

          {{!-- Holdings Phase D — neglect / abandonment surface --}}
          {{#if holdings.isNeglected}}
            <div class="bbttcc-row bbttcc-holdings-neglect" data-tooltip="{{bbttccTip 'hex' 'holdingsNeglect'}}" style="margin-bottom:6px; padding:5px 8px; border-radius:6px; border:1px solid rgba(217,119,6,0.5); background:rgba(217,119,6,0.1);">
              <span style="color:#d97706; font-weight:700;">⚠ Neglected</span>
              <span style="margin-left:auto; color:#fbbf24;">{{holdings.neglectTurns}}/{{holdings.neglectThreshold}} unpaid</span>
            </div>
          {{else if holdings.abandonedRecent}}
            <div class="bbttcc-row bbttcc-holdings-abandoned" data-tooltip="{{bbttccTip 'hex' 'holdingsAbandoned'}}" style="margin-bottom:6px; padding:5px 8px; border-radius:6px; border:1px solid rgba(185,28,28,0.5); background:rgba(185,28,28,0.12);">
              <span style="color:#fca5a5; font-weight:700;">💔 Recently abandoned</span>
              {{#if holdings.lastAbandonedCount}}
                <span style="margin-left:auto; color:#fca5a5; font-size:.78rem;">{{holdings.lastAbandonedCount}} unit(s) lost</span>
              {{/if}}
            </div>
          {{/if}}

          {{#if holdings.hasAny}}
            {{#if holdings.bosses.length}}
              <div class="bbttcc-muted" style="font-size:.75rem; margin-top:6px; text-transform:uppercase; letter-spacing:.06em;" data-tooltip="{{bbttccTip 'hex' 'holdingsBosses'}}">Bosses · +{{holdings.bossesBonus}}</div>
              {{#each holdings.bosses}}
              <div class="bbttcc-row bbttcc-holdings-row" style="margin-top:4px; gap:6px; align-items:center;">
                <span style="flex:1 1 auto; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                  <span class="bbttcc-pill bbttcc-pill-soft" style="color:#a78bfa; font-size:.7rem;">T{{tier}}</span>
                  {{label}}
                </span>
                <span class="bbttcc-pill" style="color:#fbbf24; font-size:.75rem;">+{{bonus}}</span>
                {{#if ../isGM}}
                  <button type="button" class="bbttcc-btn bbttcc-btn-small" data-action="holdings-remove" data-kind="boss" data-id="{{id}}" data-tooltip="{{bbttccTip 'hex' 'holdingsRemove'}}" style="opacity:.7;">×</button>
                {{/if}}
              </div>
              {{/each}}
            {{/if}}

            {{#if holdings.rigs.length}}
              <div class="bbttcc-muted" style="font-size:.75rem; margin-top:8px; text-transform:uppercase; letter-spacing:.06em;" data-tooltip="{{bbttccTip 'hex' 'holdingsRigs'}}">Rigs · +{{holdings.rigsBonus}}{{#if holdings.rigsCapped}} <span style="color:#f97316;">(cap)</span>{{/if}}</div>
              {{#each holdings.rigs}}
              <div class="bbttcc-row bbttcc-holdings-row" style="margin-top:4px; gap:6px; align-items:center;">
                <span style="flex:1 1 auto; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                  <span class="bbttcc-pill bbttcc-pill-soft" style="color:#60a5fa; font-size:.7rem; text-transform:capitalize;">{{bracket}}</span>
                  {{label}}
                </span>
                <span class="bbttcc-pill" style="color:#fbbf24; font-size:.75rem;">+{{bonus}}</span>
                {{#if ../isGM}}
                  <button type="button" class="bbttcc-btn bbttcc-btn-small" data-action="holdings-remove" data-kind="rig" data-id="{{id}}" data-tooltip="{{bbttccTip 'hex' 'holdingsRemove'}}" style="opacity:.7;">×</button>
                {{/if}}
              </div>
              {{/each}}
            {{/if}}

            {{#if holdings.facilities.length}}
              <div class="bbttcc-muted" style="font-size:.75rem; margin-top:8px; text-transform:uppercase; letter-spacing:.06em;" data-tooltip="{{bbttccTip 'hex' 'holdingsFacilities'}}">Facilities · +{{holdings.facilitiesBonus}}{{#if holdings.facilitiesCapped}} <span style="color:#f97316;">(cap)</span>{{/if}}</div>
              {{#each holdings.facilities}}
              <div class="bbttcc-row bbttcc-holdings-row" style="margin-top:4px; gap:6px; align-items:center;">
                <span style="flex:1 1 auto; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                  <span class="bbttcc-pill bbttcc-pill-soft" style="color:#34d399; font-size:.7rem; text-transform:capitalize;">{{#if facilityType}}{{facilityType}}{{else}}facility{{/if}}</span>
                  {{label}}
                </span>
                <span class="bbttcc-pill" style="color:#fbbf24; font-size:.75rem;">+{{bonus}}</span>
                {{#if ../isGM}}
                  <button type="button" class="bbttcc-btn bbttcc-btn-small" data-action="holdings-remove" data-kind="rig" data-id="{{id}}" data-tooltip="{{bbttccTip 'hex' 'holdingsRemove'}}" style="opacity:.7;">×</button>
                {{/if}}
              </div>
              {{/each}}
            {{/if}}

            {{#if holdings.missing.length}}
              <div class="bbttcc-muted" style="font-size:.7rem; margin-top:8px; color:#f87171;" data-tooltip="{{bbttccTip 'hex' 'holdingsMissing'}}">⚠ {{holdings.missing.length}} stale reference(s) — actor removed from world</div>
              {{#each holdings.missing}}
              <div class="bbttcc-row bbttcc-holdings-row" style="margin-top:4px; gap:6px; opacity:.6;">
                <span style="flex:1 1 auto; font-size:.75rem;">{{label}}</span>
                {{#if ../isGM}}
                  <button type="button" class="bbttcc-btn bbttcc-btn-small" data-action="holdings-remove" data-kind="any" data-id="{{id}}" data-tooltip="{{bbttccTip 'hex' 'holdingsRemove'}}" style="opacity:.7;">×</button>
                {{/if}}
              </div>
              {{/each}}
            {{/if}}
          {{else}}
            <div class="bbttcc-muted" style="font-size:.8rem; padding:4px 2px;">No Holdings stationed. {{#if isGM}}Press <b>＋ Station</b> to add rigs, bosses, or facilities.{{/if}}</div>
          {{/if}}
        </div>

        <div class="bbttcc-hex-card" style="padding:8px 10px;" data-tour="hex.tracks">
          <div style="font-weight:800; margin-bottom:6px;" data-tooltip="{{bbttccTip 'hex' 'tracks'}}">Tracks &amp; State</div>

          <div class="bbttcc-row" data-tooltip="{{bbttccTip 'hex' 'integration'}}" data-tour="hex.integration">
            <span>Integration ({{integrationProgress}}/6)</span>
            <span class="bbttcc-track" style="color:#22c55e;">{{integrationPips}}</span>
          </div>

          <div class="bbttcc-row" data-tooltip="{{bbttccTip 'hex' 'radiation'}}" data-tour="hex.radiation">
            <span>Radiation ({{radiation}})</span>
            <span class="bbttcc-track" style="color:#f97316;">{{radiationPips}}</span>
          </div>

          <div class="bbttcc-row" data-tooltip="{{bbttccTip 'hex' 'darkness'}}" data-tour="hex.darkness">
            <span>Local Darkness ({{darkness}})</span>
            <span class="bbttcc-track" style="color:#a855f7;">{{darknessPips}}</span>
          </div>

          {{#if weather.active}}
          <div class="bbttcc-row" style="margin-top:6px;">
            <span data-tooltip="{{bbttccTip 'hex' 'weather'}}">Weather</span>
            <span class="bbttcc-pill bbttcc-pill-soft" data-tooltip="{{weather.tooltip}}" data-tooltip-direction="UP" style="color:#88c8ff;">
              ☁ {{weather.label}} <small style="opacity:0.7;">({{weather.remainingTurns}})</small>
            </span>
          </div>
          {{/if}}
        </div>

        <div class="bbttcc-hex-card" style="padding:8px 10px;" data-bbttcc-pressure="1" data-tour="hex.pressure">
          <div class="bbttcc-row" style="margin-bottom:6px;">
            <div style="font-weight:800;" data-tooltip="{{bbttccTip 'hex' 'pressure'}}">Pressure &amp; Conditions</div>
            {{#if isGM}}
              <span class="bbttcc-pill bbttcc-pill-soft">GM</span>
            {{/if}}
          </div>

          <div class="bbttcc-row" data-tooltip="{{bbttccTip 'hex' 'radiationTier'}}">
            <span>Radiation Tier</span>
            <span class="bbttcc-pill bbttcc-pill-soft">{{radiationTier}}</span>
          </div>

          <div class="bbttcc-row" style="margin-top:6px;" data-tooltip="{{bbttccTip 'hex' 'conditions'}}">
            <span>Conditions</span>
            <span class="bbttcc-muted" style="font-size:.82rem;">{{conditionsCount}}</span>
          </div>

          {{#if hasConditions}}
            <div class="bbttcc-chiprow" style="margin-top:6px;">
              {{#each conditions}}
                <span class="bbttcc-pill bbttcc-pill-soft">{{this}}</span>
              {{/each}}
            </div>
          {{else}}
            <div class="bbttcc-muted" style="margin-top:6px;">No persistent conditions.</div>
          {{/if}}

          {{#if isGM}}
            <hr class="bbttcc-hr"/>

            <div class="bbttcc-muted" style="font-size:.78rem; margin-bottom:6px;" data-tour="hex.gmControls">GM Controls</div>

            <div class="bbttcc-row" style="align-items:center;" data-tooltip="{{bbttccTip 'hex' 'gmRad'}}">
              <span>Radiation</span>
              <div class="bbttcc-chiprow" style="justify-content:flex-end;">
                <button type="button" class="bbttcc-btn bbttcc-btn-small" data-action="hex-rad" data-delta="-5">-5</button>
                <button type="button" class="bbttcc-btn bbttcc-btn-small" data-action="hex-rad" data-delta="-1">-1</button>
                <button type="button" class="bbttcc-btn bbttcc-btn-small" data-action="hex-rad" data-delta="1">+1</button>
                <button type="button" class="bbttcc-btn bbttcc-btn-small" data-action="hex-rad" data-delta="5">+5</button>
              </div>
            </div>

            <div class="bbttcc-row" style="align-items:center; margin-top:6px;" data-tooltip="{{bbttccTip 'hex' 'gmDark'}}">
              <span>Darkness</span>
              <div class="bbttcc-chiprow" style="justify-content:flex-end;">
                <button type="button" class="bbttcc-btn bbttcc-btn-small" data-action="hex-dark" data-delta="-1">-1</button>
                <button type="button" class="bbttcc-btn bbttcc-btn-small" data-action="hex-dark" data-delta="1">+1</button>
              </div>
            </div>

            <div class="bbttcc-chiprow" style="margin-top:8px;">
              <button type="button" class="bbttcc-btn bbttcc-btn-small" data-action="hex-cond" data-cond="Radiated" data-tooltip="{{bbttccTip 'hex' 'gmConditions'}}">Toggle Radiated</button>
              <button type="button" class="bbttcc-btn bbttcc-btn-small" data-action="hex-cond" data-cond="Contaminated" data-tooltip="{{bbttccTip 'hex' 'gmConditions'}}">Toggle Contaminated</button>
              <button type="button" class="bbttcc-btn bbttcc-btn-small bbttcc-btn-good" data-action="hex-cond" data-cond="Purified" data-tooltip="{{bbttccTip 'hex' 'gmConditions'}}">Toggle Purified</button>
              <button type="button" class="bbttcc-btn bbttcc-btn-small bbttcc-btn-danger" data-action="hex-cond" data-cond="Corrupted" data-tooltip="{{bbttccTip 'hex' 'gmConditions'}}">Toggle Corrupted</button>
              <button type="button" class="bbttcc-btn bbttcc-btn-small" data-action="hex-cond-clear" data-tooltip="{{bbttccTip 'hex' 'gmCondClear'}}">Clear All</button>
            </div>

            <div class="bbttcc-muted" style="font-size:.75rem; margin-top:6px;">
              These controls edit <b>flags.bbttcc-territory.mods</b> and <b>flags.bbttcc-territory.conditions</b> directly.
            </div>
          {{/if}}
        </div>

      </div>
    </aside>

    <main class="bbttcc-pane bbttcc-hex-card">

      <div class="bbttcc-tabs" role="tablist" data-tour="hex.tabs">
        <button type="button"
                class="bbttcc-tab {{#if isOverview}}active{{/if}}"
                data-bbttcc-hex-tab="overview"
                data-tooltip="{{bbttccTip 'hex' 'tabOverview'}}"
                role="tab">Overview</button>
        <button type="button"
                class="bbttcc-tab {{#if isDossier}}active{{/if}}"
                data-bbttcc-hex-tab="dossier"
                data-tooltip="{{bbttccTip 'hex' 'tabDossier'}}"
                role="tab">Dossier</button>
        {{#if dossier.stageLabel}}
          <span class="bbttcc-stage-pill" style="margin-left:auto;" data-tooltip="{{bbttccTip 'hex' 'stagePill'}}" data-tour="hex.stage">⬢ {{dossier.stageLabel}}</span>
        {{/if}}
      </div>

      <div data-bbttcc-hex-pane="overview" class="bbttcc-pane-scroll" {{#unless isOverview}}style="display:none;"{{/unless}}>
        <div class="bbttcc-hex-card" data-tour="hex.yields">
          <div style="font-weight:800; margin-bottom:6px;" data-tooltip="{{bbttccTip 'hex' 'yields'}}">Resources / Yields</div>
          {{#if hasResources}}
            <div class="bbttcc-grid">
              {{#each resourcesList}}
                <div class="bbttcc-row"><span>{{label}}</span><strong>{{value}}</strong></div>
              {{/each}}
            </div>
          {{else}}
            <div class="bbttcc-muted">No explicit resources recorded.</div>
          {{/if}}
        </div>

        <div class="bbttcc-hex-card" data-tour="hex.nodes">
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
            <div style="font-weight:800;" data-tooltip="{{bbttccTip 'hex' 'nodes'}}">Resource Nodes</div>
            {{#if isGM}}
              <div style="display:flex; gap:.3rem;">
                <button type="button" class="bbttcc-btn bbttcc-btn-small" data-action="add-hex-node" data-tooltip="{{bbttccTip 'hex' 'nodeAdd'}}">＋ Add</button>
                <button type="button" class="bbttcc-btn bbttcc-btn-small" data-action="regrow-hex-nodes" data-tooltip="{{bbttccTip 'hex' 'nodeRegrow'}}">⟳ Regrow</button>
              </div>
            {{/if}}
          </div>
          {{#if hasResourceNodes}}
            <div style="display:flex; flex-direction:column; gap:6px;">
              {{#each resourceNodes}}
                <div style="display:grid; grid-template-columns: 1fr auto; gap:6px; align-items:center; padding:6px 8px; border:1px solid rgba(55,65,81,0.6); border-radius:8px; background:rgba(15,23,42,0.55);">
                  <div>
                    <div style="font-weight:700;">
                      {{materialName}}
                      {{#if rich}}<span style="color:#facc15;" data-tooltip="{{bbttccTip 'hex' 'nodeRich'}}">★</span>{{/if}}
                      <span style="opacity:.6; font-size:.78rem; margin-left:4px;">T{{tier}}</span>
                    </div>
                    <div style="opacity:.75; font-size:.78rem;">DC {{dc}} · {{skill}} · yield {{yieldFormula}}</div>
                    <div style="opacity:.7; font-size:.74rem;">Charges: <b>{{charges}}</b> / {{maxCharges}}</div>
                  </div>
                  <div style="display:flex; gap:.3rem; align-items:center;">
                    <button type="button" class="bbttcc-btn bbttcc-btn-small" data-action="harvest-hex-node" data-node-id="{{id}}" data-tooltip="{{bbttccTip 'hex' 'nodeHarvest'}}" {{#if @first}}data-tour="hex.harvest"{{/if}}>Harvest</button>
                    {{#if ../isGM}}
                      <button type="button" class="bbttcc-btn bbttcc-btn-small" data-action="delete-hex-node" data-node-id="{{id}}" data-tooltip="{{bbttccTip 'hex' 'nodeDelete'}}" style="opacity:.7;">×</button>
                    {{/if}}
                  </div>
                </div>
              {{/each}}
            </div>
            {{#if depletedNodes}}
              <div class="bbttcc-muted" style="font-size:.78rem; margin-top:6px;">{{depletedNodes}} depleted (hidden) — GM can regrow.</div>
            {{/if}}
          {{else}}
            <div class="bbttcc-muted">No resource nodes here{{#if depletedNodes}} (all depleted){{/if}}{{#if isGM}} — click <b>＋ Add</b> to author one.{{/if}}</div>
          {{/if}}
        </div>

        {{#if buildUnits.enabled}}
        <div class="bbttcc-hex-card" data-tour="hex.buildUnits">
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
            <div style="font-weight:800;" data-tooltip="{{bbttccTip 'hex' 'buildUnits'}}">Build Units (Engineering)</div>
            {{#if buildUnits.hasOwner}}
              <span data-tooltip="Owning faction: {{buildUnits.ownerName}} · Build Units available: {{buildUnits.balance}}"
                    data-tour="hex.buBalance"
                    style="display:inline-flex; align-items:center; gap:.3rem; padding:.1rem .55rem; border:1px solid rgba(232,200,74,.45); border-radius:10px; font-size:11px; color:#e8c84a; background:rgba(232,200,74,.08); white-space:nowrap;">
                <i class="fas fa-hammer" style="font-size:10px; opacity:.85;"></i>
                BU: <b>{{buildUnits.balance}}</b>
              </span>
            {{else}}
              <span class="bbttcc-muted" style="font-size:.78rem;">No owner</span>
            {{/if}}
          </div>
          <div class="bbttcc-chiprow" style="gap:.35rem; flex-wrap:wrap;">
            <button type="button" class="bbttcc-btn bbttcc-btn-small" data-action="bu-spend" data-bu-action="fortify"
                    {{#unless buildUnits.canFortify}}disabled{{/unless}} data-tooltip="{{buildUnits.fortifyTip}}" data-tour="hex.fortify">
              Fortify Hex — {{buildUnits.costs.fortify}} BU
            </button>
            <button type="button" class="bbttcc-btn bbttcc-btn-small" data-action="bu-spend" data-bu-action="repair"
                    {{#unless buildUnits.canRepair}}disabled{{/unless}} data-tooltip="{{buildUnits.repairTip}}" data-tour="hex.repair">
              Repair Hex — {{buildUnits.costs.repair}} BU
            </button>
            <button type="button" class="bbttcc-btn bbttcc-btn-small" data-action="bu-spend" data-bu-action="asset"
                    {{#unless buildUnits.canAsset}}disabled{{/unless}} data-tooltip="{{buildUnits.assetTip}}" data-tour="hex.asset">
              {{buildUnits.assetLabel}}
            </button>
          </div>
          <div class="bbttcc-muted" style="font-size:.78rem; margin-top:6px;">{{buildUnits.hint}}</div>
        </div>
        {{/if}}

        <div class="bbttcc-hex-card" data-tour="hex.gmNotes">
          <div style="font-weight:800; margin-bottom:6px;" data-tooltip="{{bbttccTip 'hex' 'gmNotes'}}">GM Notes</div>
          <div class="bbttcc-muted" style="white-space:pre-wrap;">{{notes}}</div>
        </div>
      </div>

      <div data-bbttcc-hex-pane="dossier" class="bbttcc-pane-scroll" {{#unless isDossier}}style="display:none;"{{/unless}}>

        <div class="bbttcc-hex-card" data-tour="hex.whatsHere">
          <div style="font-weight:800; margin-bottom:6px;" data-tooltip="{{bbttccTip 'hex' 'whatsHere'}}">What's Here</div>
          <div class="bbttcc-row" data-tooltip="{{bbttccTip 'hex' 'stagePill'}}">
            <span>Stage</span>
            <strong>{{dossier.stageLabel}}</strong>
          </div>
          {{#if dossier.sephirotName}}
            <div class="bbttcc-row" style="margin-top:4px;" data-tooltip="{{bbttccTip 'hex' 'sephirot'}}" data-tour="hex.sephirot">
              <span>Sephirot</span>
              <strong style="text-transform:capitalize;">{{dossier.sephirotName}}</strong>
            </div>
          {{/if}}
          {{#if dossier.productionShown}}
            <hr class="bbttcc-hr"/>
            <div class="bbttcc-muted" style="font-size:.78rem; margin-bottom:4px;" data-tooltip="{{bbttccTip 'hex' 'production'}}">
              Production trace
              {{#if dossier.manualOverride}}<span style="color:#facc15; margin-left:6px;" data-tooltip="{{bbttccTip 'hex' 'prodManual'}}">(manual)</span>{{/if}}
            </div>
            <div class="bbttcc-prod-table">
              <div class="bbttcc-prod-head">Resource</div>
              <div class="bbttcc-prod-head" style="text-align:right;">Base</div>
              <div class="bbttcc-prod-head" style="text-align:right;">×Size</div>
              <div class="bbttcc-prod-head" style="text-align:right;">Final</div>
              {{#each dossier.productionRows}}
                <div>{{label}}</div>
                <div style="text-align:right; opacity:.7;">{{base}}</div>
                <div style="text-align:right; opacity:.85;">{{sized}}</div>
                <div style="text-align:right; font-weight:700;">{{final}}</div>
              {{/each}}
            </div>
            <div class="bbttcc-muted" style="font-size:.7rem; margin-top:6px;">
              integration ×{{dossier.integMult}} · size mult {{dossier.sizeMult}}
            </div>
          {{/if}}
        </div>

        <div class="bbttcc-hex-card" data-tour="hex.modifiers">
          <div style="font-weight:800; margin-bottom:6px;" data-tooltip="{{bbttccTip 'hex' 'modifiers'}}">Active Modifiers</div>
          {{#if dossier.hasActiveModifiers}}
            {{#each dossier.activeModifiers}}
              <div class="bbttcc-mod-row">
                <div class="bbttcc-mod-name">{{name}}</div>
                <div class="bbttcc-mod-desc">{{description}}</div>
                {{#if addedTs}}
                  <div class="bbttcc-mod-meta">
                    Added {{addedTs}}{{#if addedTurn}} · turn {{addedTurn}}{{/if}}{{#if sourceActivity}} · via {{sourceActivity}}{{/if}}
                  </div>
                {{/if}}
              </div>
            {{/each}}
          {{else}}
            <div class="bbttcc-muted">No active modifiers on this hex.</div>
          {{/if}}
        </div>

        <div class="bbttcc-hex-card" data-tour="hex.timeline">
          <div style="font-weight:800; margin-bottom:6px;" data-tooltip="{{bbttccTip 'hex' 'timeline'}}">How We Got Here</div>
          {{#if dossier.hasTimeline}}
            <div class="bbttcc-timeline">
              {{#each dossier.timeline}}
                <div class="bbttcc-timeline-row">
                  <i class="{{kindIcon}}"></i>
                  <div>
                    <div class="bbttcc-timeline-label">{{label}}</div>
                    {{#if description}}
                      <div class="bbttcc-timeline-desc">{{description}}</div>
                    {{/if}}
                  </div>
                  <div class="bbttcc-timeline-meta">
                    {{#if turn}}<div>{{turn}}</div>{{/if}}
                    {{#if when}}<div>{{when}}</div>{{/if}}
                  </div>
                </div>
              {{/each}}
            </div>
          {{else}}
            <div class="bbttcc-muted">No recorded improvements yet — actions and changes will show up here.</div>
          {{/if}}
        </div>

        <div class="bbttcc-hex-card" data-tour="hex.nextSteps">
          <div style="font-weight:800; margin-bottom:6px;" data-tooltip="{{bbttccTip 'hex' 'nextSteps'}}">What's Next</div>
          {{#if dossier.nextStepsHasAny}}

            {{#if dossier.nextSteps.integration.length}}
              <div class="bbttcc-next-group">
                <h4>Integration</h4>
                {{#each dossier.nextSteps.integration}}
                  <div class="bbttcc-next-row">
                    <div class="bbttcc-next-label">{{label}}</div>
                    {{#if detail}}<div class="bbttcc-next-detail">{{detail}}</div>{{/if}}
                    {{#if activityKeys.length}}
                      <div class="bbttcc-next-acts">
                        <span class="bbttcc-next-acts-label">Plan via:</span>
                        {{#each activityKeys}}
                          <button type="button"
                                  class="bbttcc-act-pill"
                                  data-bbttcc-deep-plan="1"
                                  data-activity-key="{{this}}"
                                  data-tooltip="{{bbttccTip 'hex' 'planPill'}}">{{this}}</button>
                        {{/each}}
                      </div>
                    {{/if}}
                  </div>
                {{/each}}
              </div>
            {{/if}}

            {{#if dossier.nextSteps.typeSize.length}}
              <div class="bbttcc-next-group">
                <h4>Type / Size</h4>
                {{#each dossier.nextSteps.typeSize}}
                  <div class="bbttcc-next-row">
                    <div class="bbttcc-next-label">{{label}}</div>
                    {{#if detail}}<div class="bbttcc-next-detail">{{detail}}</div>{{/if}}
                    {{#if activityKeys.length}}
                      <div class="bbttcc-next-acts">
                        <span class="bbttcc-next-acts-label">Plan via:</span>
                        {{#each activityKeys}}
                          <button type="button"
                                  class="bbttcc-act-pill"
                                  data-bbttcc-deep-plan="1"
                                  data-activity-key="{{this}}"
                                  data-tooltip="{{bbttccTip 'hex' 'planPill'}}">{{this}}</button>
                        {{/each}}
                      </div>
                    {{/if}}
                  </div>
                {{/each}}
              </div>
            {{/if}}

            {{#if dossier.nextSteps.sephirot.length}}
              <div class="bbttcc-next-group">
                <h4>Sephirot</h4>
                {{#each dossier.nextSteps.sephirot}}
                  <div class="bbttcc-next-row">
                    <div class="bbttcc-next-label">{{label}}</div>
                    {{#if detail}}<div class="bbttcc-next-detail">{{detail}}</div>{{/if}}
                    {{#if configHint}}<div class="bbttcc-next-acts">{{configHint}}</div>{{/if}}
                  </div>
                {{/each}}
              </div>
            {{/if}}

            {{#if dossier.nextSteps.modifiers.length}}
              <div class="bbttcc-next-group">
                <h4>Modifiers</h4>
                {{#each dossier.nextSteps.modifiers}}
                  <div class="bbttcc-next-row">
                    <div class="bbttcc-next-label">{{label}}</div>
                    {{#if detail}}<div class="bbttcc-next-detail">{{detail}}</div>{{/if}}
                    {{#if activityKeys.length}}
                      <div class="bbttcc-next-acts">
                        <span class="bbttcc-next-acts-label">Plan via:</span>
                        {{#each activityKeys}}
                          <button type="button"
                                  class="bbttcc-act-pill"
                                  data-bbttcc-deep-plan="1"
                                  data-activity-key="{{this}}"
                                  data-tooltip="{{bbttccTip 'hex' 'planPill'}}">{{this}}</button>
                        {{/each}}
                      </div>
                    {{/if}}
                  </div>
                {{/each}}
              </div>
            {{/if}}

            {{#if dossier.nextSteps.ownerActions.length}}
              <div class="bbttcc-next-group">
                <h4>Owner Actions</h4>
                {{#each dossier.nextSteps.ownerActions}}
                  <div class="bbttcc-next-row">
                    <div class="bbttcc-next-label">{{label}}</div>
                    {{#if detail}}<div class="bbttcc-next-detail">{{detail}}</div>{{/if}}
                  </div>
                {{/each}}
              </div>
            {{/if}}

          {{else}}
            <div class="bbttcc-muted">Nothing to suggest — this hex is in good shape.</div>
          {{/if}}
        </div>

      </div>
    </main>

  </div>
</section>
