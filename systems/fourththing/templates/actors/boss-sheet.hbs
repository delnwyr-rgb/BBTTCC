<div class="ft-sheet ft-boss-sheet bbttcc-sheet bbttcc-boss-sheet flexcol{{#if gmEdit}} ft-edit-mode{{/if}}">

  <header class="ft-header ft-boss-header flexrow">

    <div class="ft-identity ft-boss-identity flexcol">
      <div class="ft-portrait" data-action="ftEditPortrait" data-tooltip="Click to change portrait">
        <img src="{{actor.img}}" data-tooltip="{{actor.name}}"/>
        <div class="ft-portrait-overlay">📷</div>
      </div>
      <div class="ft-name flexrow" style="align-items:center; gap:0.4rem;">
        <input name="name" type="text" value="{{actor.name}}" placeholder="Boss Name" style="flex:1 1 auto;"/>
        <button type="button" class="ft-mini-btn ft-boss-duplicate" data-action="ftBossDuplicate"
                data-tooltip="Open the Boss Builder pre-filled with this boss's current state."
                style="white-space:nowrap;">
          <i class="fas fa-copy"></i> Duplicate
        </button>
      </div>

      <div class="ft-boss-id-pills flexrow">
        <div class="ft-meta-pill ft-id-archetype ft-boss-id-pill" data-tooltip="Free-text archetype tag — drives manifestation library curation.">
          <span class="ft-meta-label">Archetype</span>
          <input type="text" name="system.identity.archetype" value="{{identity.archetype}}" placeholder="archetype"/>
        </div>

        {{#if faction}}
        <div class="ft-meta-pill ft-id-faction ft-boss-id-pill" data-tooltip="Affiliated faction.">
          <span class="ft-meta-label">Faction</span>
          <span class="ft-meta-val">{{faction.name}}</span>
        </div>
        {{else}}
        <div class="ft-meta-pill ft-id-faction-empty ft-boss-id-pill" data-tooltip="Drop a faction actor onto the sheet to bind.">
          <span class="ft-meta-label">Faction</span><span class="ft-meta-val">— unbound —</span>
        </div>
        {{/if}}

        <div class="ft-meta-pill ft-id-tier ft-boss-id-pill">
          <span class="ft-meta-label">Tier</span><span class="ft-meta-val">T{{integrity.tier}} · {{integrity.bracket}}</span>
        </div>
      </div>
    </div>

    {{!-- Stat block — Slice 3 polish (2026-05-12): boxed-tile grid layout
         mirroring the NPC Derived/Manifestations panels. Each tile carries its
         own ± controls inline. Integrity tile spans full width so it can host
         the fill bar. --}}
    <div class="ft-boss-summary ft-boss-stat-grid">

      <div class="ft-boss-stat-tile ft-boss-stat-integrity ft-stat-span-2" data-tooltip="Integrity — boss's health pool. Phase changes fire at thresholds.">
        <div class="ft-boss-stat-label">Integrity</div>
        <div class="ft-boss-stat-row">
          <button type="button" class="ft-mini-btn" data-action="ftBossIntegrityAdjust" data-delta="-1" data-tooltip="-1">−</button>
          <span class="ft-boss-stat-val">{{integrity.value}}</span>
          <span class="ft-boss-stat-sep">/</span>
          <span class="ft-boss-stat-max">{{integrity.max}}</span>
          <button type="button" class="ft-mini-btn" data-action="ftBossIntegrityAdjust" data-delta="1" data-tooltip="+1">+</button>
        </div>
        <div class="ft-integrity-bar ft-boss-integrity-bar">
          <div class="ft-integrity-fill" style="width: {{integrityPct}}%"></div>
        </div>
      </div>

      <div class="ft-boss-stat-tile ft-boss-stat-phase" data-tooltip="Boss phase ladder — current/total. « retreats, » advances.">
        <div class="ft-boss-stat-label">Phase</div>
        <div class="ft-boss-stat-row">
          {{#if ladder.length}}
          <button type="button" class="ft-mini-btn" data-action="ftBossPhaseRetreat" data-tooltip="Retreat one phase">«</button>
          <span class="ft-boss-stat-val ft-boss-stat-val-text">{{currentPhaseEntry.label}}</span>
          <span class="ft-boss-stat-sep">·</span>
          <span class="ft-boss-stat-max">{{phases.currentPhase}}/{{ladder.length}}</span>
          <button type="button" class="ft-mini-btn" data-action="ftBossPhaseAdvance" data-tooltip="Advance one phase">»</button>
          {{else}}
          <em class="ft-boss-stat-empty">No phases authored</em>
          {{/if}}
        </div>
      </div>

      <div class="ft-boss-stat-tile ft-boss-stat-surge" data-tooltip="Surge bank — exploding 2d10 reservoir. Spend on manifestations and reactions. Click value to spend.">
        <div class="ft-boss-stat-label">Surge</div>
        <div class="ft-boss-stat-row">
          <button type="button" class="ft-mini-btn" data-action="ftBossSurgeAdjust" data-delta="-1">−</button>
          <span data-action="ftSurgeSpend" class="ft-boss-stat-val ft-surge-spend">{{manifestations.surge.current}}</span>
          <span class="ft-boss-stat-sep">/</span>
          <span class="ft-boss-stat-max">{{manifestations.surge.max}}</span>
          <button type="button" class="ft-mini-btn" data-action="ftBossSurgeAdjust" data-delta="1">+</button>
        </div>
      </div>

      <div class="ft-boss-stat-tile ft-boss-stat-momentum" data-tooltip="Momentum — narrative pressure track that the boss accrues across rounds.">
        <div class="ft-boss-stat-label">Momentum</div>
        <div class="ft-boss-stat-row">
          <button type="button" class="ft-mini-btn" data-action="ftBossMomentumAdjust" data-delta="-1">−</button>
          <span class="ft-boss-stat-val">{{manifestations.momentum}}</span>
          <button type="button" class="ft-mini-btn" data-action="ftBossMomentumAdjust" data-delta="1">+</button>
        </div>
      </div>

    </div>
  </header>

  <div class="ft-tabs-bar">
    <nav class="ft-tabs" data-group="primary">
      {{#each tabs as |t|}}{{#if t.visible}}<a class="item{{#if t.active}} active{{/if}}" data-tab="{{t.id}}">{{t.label}}</a>{{/if}}{{/each}}
    </nav>
  </div>

  <div class="ft-body">

    {{!-- IDENTITY TAB --}}
    <div class="tab identity{{#if (eq activeTab "identity")}} active{{/if}}" data-tab="identity">
      <section class="ft-boss-identity-grid">
        <div class="ft-meta">
          <label data-tooltip="Free-text archetype — see header pill.">Archetype</label>
          <span class="ft-readonly">{{identity.archetype}}</span>
        </div>
        <div class="ft-meta ft-meta-span-2">
          <label data-tooltip="Archetype tags (comma-separated) — drive the manifestation picker filter. Items tagged with any of these (via flags.fourththing.bossArchetypeTags or system.tags) appear in the Archetype Matches group. Use `boss-universal` on items meant for any boss.">Archetype Tags</label>
          <input type="text" data-ft-boss-edit-csv="system.identity.archetypeTags" value="{{identityArchetypeTagsCsv}}" placeholder="void, swarm, conduit, siegelord"/>
        </div>
        <div class="ft-meta">
          <label data-tooltip="Bound faction id (or unbound).">Faction</label>
          <span class="ft-readonly">{{#if faction}}{{faction.name}}{{else}}— unbound —{{/if}}</span>
        </div>
        <div class="ft-meta">
          <label data-tooltip="Boss def key — used by raid console creature picker (Phase 7 wiring).">Raid Def Key</label>
          <input type="text" data-ft-boss-edit="system.raidProfile.key" value="{{raidProfile.key}}" placeholder="unique_key"/>
        </div>
        <div class="ft-meta">
          <label data-tooltip="Tags — comma-separated.">Tags</label>
          <input type="text" data-ft-boss-edit="system.raidProfile.tagsRaw" value="{{raidProfile.tagsRaw}}" placeholder="qliphothic, megafauna, courtly"/>
        </div>
      </section>
    </div>

    {{!-- PHASE LADDER TAB --}}
    <div class="tab phases{{#if (eq activeTab "phases")}} active{{/if}}" data-tab="phases">
      <section class="ft-boss-phase-editor">
        <div class="ft-block-title">Phase Ladder
          <span class="ft-block-hint">(integrity threshold = % of max that triggers phase entry; surge boost grants Surge dice on entry)</span>
          <button type="button" class="ft-action-btn" data-action="ftBossPhaseAdd" data-tooltip="Add a phase">+ Phase</button>
        </div>
        {{#if ladder.length}}
        <table class="ft-phase-table">
          <thead><tr><th>#</th><th>Label</th><th>Threshold %</th><th>Surge Boost</th><th>Manifestations</th><th>Active</th><th></th></tr></thead>
          <tbody>
            {{#each ladder as |p|}}
            <tr data-phase-idx="{{p.idx}}"{{#if p.active}} class="ft-phase-row-active"{{/if}}>
              <td>{{p.idx}}</td>
              <td><input type="text" data-ft-boss-edit="system.phases.ladder.{{p.idx}}.label" value="{{p.label}}"/></td>
              <td><input type="number" data-ft-boss-edit="system.phases.ladder.{{p.idx}}.integrityThreshold" value="{{p.integrityThreshold}}" min="0" max="100"/></td>
              <td><input type="number" data-ft-boss-edit="system.phases.ladder.{{p.idx}}.surgeBoost" value="{{p.surgeBoost}}" min="0"/></td>
              <td>{{p.manifestationGrants.length}} grants</td>
              <td>{{#if p.active}}● current{{else}}—{{/if}}</td>
              <td><button type="button" class="ft-mini-btn" data-action="ftBossPhaseRemove" data-tooltip="Remove this phase">×</button></td>
            </tr>
            {{/each}}
          </tbody>
        </table>
        {{else}}
        <div class="ft-rig-item-empty">No phases yet. Click <strong>+ Phase</strong> to add one.</div>
        {{/if}}
      </section>
    </div>

    {{!-- COMBAT TAB --}}
    <div class="tab combat{{#if (eq activeTab "combat")}} active{{/if}}" data-tab="combat">

      {{!-- Action Economy canon §6.2 + §6.3 (Phase C 2026-05-19) — per-round combat resources --}}
      <section class="ft-boss-combat-resources bbttcc-panel">
        <div class="ft-block-title">
          Round Resources <span class="ft-block-hint">(refill on round advance or via Refill below)</span>
          <button type="button" class="ft-action-btn ft-block-action" data-action="ftBossLegendaryReset"
                  data-tooltip="Manual refill — Manifestation Slots + Legendary Actions to max.">↻ Refill</button>
        </div>
        <div class="ft-boss-resource-row" style="display:flex;gap:0.75rem;flex-wrap:wrap;align-items:center;padding:0.4rem 0.6rem">
          <div class="ft-boss-resource-tile" data-tooltip="Manifestation Slots — Tier-many casts per round. T1=1, T2=2, T3=3, T4=4."
               style="display:flex;gap:0.4rem;align-items:center;padding:0.3rem 0.55rem;border:1px solid #6a4aa0;border-radius:6px;background:#1e1530">
            <span style="font-size:1.1rem">✦</span>
            <span style="font-size:0.78rem;opacity:0.9">Mani Slots</span>
            <b style="color:#dac8ff">{{bossManifestationSlots.current}}/{{bossManifestationSlots.max}}</b>
          </div>
          <div class="ft-boss-resource-tile" data-tooltip="Legendary Actions — T3=1, T4=2 per round, spent between PC turns."
               style="display:flex;gap:0.4rem;align-items:center;padding:0.3rem 0.55rem;border:1px solid #c8a0ff;border-radius:6px;background:#2a1a3e">
            <span style="font-size:1.1rem">⚜</span>
            <span style="font-size:0.78rem;opacity:0.9">Legendary</span>
            {{#if bossLegendaryActions.enabled}}
              <b style="color:#e8d8ff">{{bossLegendaryActions.current}}/{{bossLegendaryActions.max}}</b>
              <button type="button" class="ft-mini-btn" data-action="ftBossLegendaryOpen"
                      data-tooltip="Spend a Legendary Action — opens the picker with built-in + authored entries."
                      {{#unless bossLegendaryActions.current}}disabled{{/unless}}>Spend</button>
            {{else}}
              <em style="opacity:0.7;font-size:0.78rem">T3+ only (current: T{{bossLegendaryActions.tier}})</em>
            {{/if}}
          </div>
        </div>
      </section>

      {{#if bossLegendaryActions.enabled}}
      <section class="ft-boss-legendary-menu bbttcc-panel">
        <div class="ft-block-title">
          Legendary Menu <span class="ft-block-hint">(authored extras — built-in Move/Strike/Cast always appear in the picker)</span>
          <button type="button" class="ft-action-btn ft-block-action" data-action="ftBossLegendaryAuthor"
                  data-tooltip="Add an authored Legendary entry (e.g. 'Aura Pulse', 'Summon Mook').">+ Add Entry</button>
        </div>
        {{#if bossLegendaryActions.menu.length}}
        <div class="ft-rig-item-list">
          {{#each bossLegendaryActions.menu as |entry idx|}}
          <div class="ft-rig-item" style="display:flex;gap:0.5rem;align-items:center">
            <span style="font-size:1.1rem">{{entry.icon}}</span>
            <span class="ft-rig-item-name" style="min-width:8rem"><b>{{entry.label}}</b></span>
            <span style="font-size:0.75rem;opacity:0.8;flex:1">{{entry.description}}</span>
            <button type="button" class="ft-mini-btn" data-action="ftBossLegendaryRemove" data-idx="{{idx}}"
                    data-tooltip="Remove entry">×</button>
          </div>
          {{/each}}
        </div>
        {{else}}
        <div class="ft-rig-item-empty">No authored Legendary entries — built-in Move / Strike / Cast still appear in the picker.</div>
        {{/if}}
      </section>
      {{/if}}

      <section class="ft-boss-defenses">
        <div class="ft-block-title">Defenses <span class="ft-block-hint">(click Defense to cycle none → resist → immune; Vuln toggles independently)</span></div>
        <table class="ft-defense-table">
          <thead><tr><th>Damage Type</th><th>Defense</th><th>Vulnerable</th></tr></thead>
          <tbody>
            {{#each defenseRows as |row|}}
            <tr>
              <td class="ft-def-type">{{row.label}}</td>
              <td class="ft-def-cell{{#if row.isResist}} ft-def-cell--resist{{/if}}{{#if row.isImmune}} ft-def-cell--immune{{/if}}" data-action="ftDefenseCycle" data-type="{{row.key}}" data-tooltip="Click to cycle: none → resist → immune → none">
                {{#if row.isImmune}}Immune{{else}}{{#if row.isResist}}Resist{{else}}—{{/if}}{{/if}}
              </td>
              <td class="ft-def-cell{{#if row.isVuln}} active{{/if}}" data-action="ftVulnToggle" data-type="{{row.key}}" data-tooltip="Toggle vulnerability">
                {{#if row.isVuln}}✓ Vulnerable{{else}}—{{/if}}
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </section>
    </div>

    {{!-- MANIFESTATIONS TAB --}}
    <div class="tab manifest{{#if (eq activeTab "manifest")}} active{{/if}}" data-tab="manifest">

      {{!-- Sub-section 1: curated manifestation library --}}
      <section class="ft-boss-manifest-library bbttcc-panel">
        <div class="ft-block-title">
          Manifestation Library
          <button type="button" class="ft-action-btn ft-block-action" data-action="ftBossManifestCreate"
                  data-tooltip="Open the V2 Manifestation Engine to author a brand-new manifestation. Created as a world Item and auto-added to this boss's library.">
            🧪 Create New
          </button>
          <button type="button" class="ft-action-btn ft-block-action" data-action="ftBossManifestPick"
                  data-tooltip="Browse and pick a pre-authored `power` item from compendia / world.">
            + Add Existing
          </button>
        </div>
        <div class="ft-block-hint">Curated `power` items the boss may cast. Create a new one via the Manifestation Engine, pick from existing content, or drag a `power` item from a compendium directly onto the sheet.</div>
        {{#if libraryItems.length}}
        <div class="ft-rig-item-list ft-boss-manifest-list">
          {{#each libraryItems as |m|}}
          <div class="ft-rig-item ft-boss-manifest-row{{#if m.overTier}} ft-boss-manifest-over{{/if}}">
            <img src="{{m.img}}" class="ft-rig-item-img ft-boss-manifest-img" data-tooltip="{{m.name}}"/>
            <span class="ft-manifest-chip ft-tier-pill ft-tier-{{m.tier}} ft-boss-manifest-tier" data-tooltip="Manifestation tier{{#if m.overTier}} — beyond boss reach{{/if}}">T{{m.tier}}</span>
            <span class="ft-rig-item-name">{{m.name}}</span>
            {{#if m.tagChipsShown.length}}
            <span class="ft-boss-manifest-tags">
              {{#each m.tagChipsShown as |t|}}<span class="ft-tag-chip">{{t}}</span>{{/each}}
              {{#if m.tagChipsMore}}<span class="ft-tag-chip ft-tag-chip-more" data-tooltip="{{m.tagChipsMore}} more tag(s)">+{{m.tagChipsMore}}</span>{{/if}}
            </span>
            {{/if}}
            <button type="button" class="ft-mini-btn ft-boss-manifest-cast" data-action="ftBossManifestCast" data-uuid="{{m.uuid}}" data-tooltip="Invoke this manifestation (draws from Surge bank)">⚡ Cast</button>
            <button type="button" class="ft-mini-btn ft-boss-manifest-remove" data-action="ftBossManifestRemove" data-uuid="{{m.uuid}}" data-tooltip="Remove from library">×</button>
          </div>
          {{/each}}
        </div>
        {{else}}
        <div class="ft-rig-item-empty">No manifestations curated yet.</div>
        {{/if}}
      </section>

    </div>

    {{!-- POWERS TAB — Slice 3 rebuild (2026-05-11): templates moved here from
         GM Edit; boss powers phase-grouped with when/effects summaries; doctrine
         maneuvers now picker-driven against game.bbttcc.api.raid.EFFECTS. --}}
    <div class="tab powers{{#if (eq activeTab "powers")}} active{{/if}}" data-tab="powers">

      {{!-- Boss Templates — populate identity + raid stats from the registry --}}
      <section class="ft-boss-template-apply bbttcc-panel">
        <div class="ft-block-title">Boss Templates
          <span class="ft-block-hint">populates identity + raid profile from <code>bossTemplates</code></span>
        </div>
        <div class="ft-boss-pick-row">
          <select data-role="template-picker">
            <option value="">— pick a template —</option>
            {{#each templateOptions as |t|}}
            <option value="{{t.key}}" title="{{t.description}}">{{t.label}}</option>
            {{/each}}
          </select>
          <button type="button" class="ft-action-btn" data-action="ftBossTemplateApply">Apply Template</button>
        </div>
      </section>

      {{!-- Boss-Specific Powers — registry pickers + phase-grouped install list --}}
      <section class="ft-boss-power-pickers bbttcc-panel">
        <div class="ft-block-title">Boss-Specific Powers
          <span class="ft-block-hint">Raid behaviors fired on phase triggers (round_end / after_roll). Installed entries live on the Behaviors tab.</span>
        </div>
        <div class="ft-boss-pick-row">
          <select data-role="power-picker">
            <option value="">— pick a power —</option>
            {{#each phaseGroupedPowers as |g|}}
            <optgroup label="{{g.label}}">
              {{#each g.powers as |p|}}
              <option value="{{p.key}}" title="{{p.description}}"{{#if p.installed}} disabled{{/if}}>{{#if p.installed}}✓ {{/if}}{{p.label}}{{#if p.installed}} (installed){{/if}}{{#if p.endRaid}} · END:{{p.endRaid}}{{/if}}</option>
              {{/each}}
            </optgroup>
            {{/each}}
          </select>
          <button type="button" class="ft-action-btn" data-action="ftBossPowerAdd">+ Add Power</button>
        </div>
        <div class="ft-boss-pick-row">
          <select data-role="pack-picker">
            <option value="">— pick a power pack —</option>
            {{#each packOptions as |p|}}
            <option value="{{p.key}}" title="{{p.description}}"{{#if p.allInstalled}} disabled{{/if}}>{{#if p.allInstalled}}✓ {{/if}}{{p.label}} ({{p.installedCount}}/{{p.count}}{{#if p.allInstalled}} installed{{else}}{{#if p.installedCount}} installed{{/if}}{{/if}})</option>
            {{/each}}
          </select>
          <button type="button" class="ft-action-btn" data-action="ftBossPackApply">Apply Pack</button>
        </div>

        {{!-- Catalog preview — what the GM is browsing in the pickers above --}}
        {{#if phaseGroupedPowers.length}}
        <details class="ft-boss-power-catalog">
          <summary>Browse catalog ({{phaseGroupedPowers.length}} phase{{#unless (eq phaseGroupedPowers.length 1)}}s{{/unless}})</summary>
          {{#each phaseGroupedPowers as |g|}}
          <div class="ft-boss-power-phase">
            <div class="ft-boss-power-phase-label">{{g.label}}</div>
            <ul class="ft-boss-power-phase-list">
              {{#each g.powers as |p|}}
              <li class="ft-boss-power-row{{#if p.installed}} ft-boss-power-row--installed{{/if}}">
                <span class="ft-boss-power-name">{{#if p.installed}}<span class="ft-boss-power-installed-mark" data-tooltip="Already installed on this boss">✓ </span>{{/if}}{{p.label}}</span>
                {{#if p.whenSummary}}<small class="ft-boss-power-when" data-tooltip="trigger conditions">when: {{p.whenSummary}}</small>{{/if}}
                {{#if p.effectsSummary}}<small class="ft-boss-power-effects" data-tooltip="world-effect output">→ {{p.effectsSummary}}</small>{{/if}}
                {{#if p.endRaid}}<small class="ft-boss-power-end" data-tooltip="ends raid on trigger">END:{{p.endRaid}}</small>{{/if}}
              </li>
              {{/each}}
            </ul>
          </div>
          {{/each}}
        </details>
        {{/if}}
      </section>

      {{!-- Raid Maneuver Doctrine — Slice 3 (2026-05-11): curated picker
           replaces the free-text input. Pills resolve against EFFECTS so the
           GM sees labels + tier badges instead of raw keys. --}}
      <section class="ft-boss-doctrine bbttcc-panel">
        <div class="ft-block-title">Raid Maneuver Doctrine
          <button type="button" class="ft-action-btn ft-block-action" data-action="ftBossManeuverPick"
                  data-tooltip="Pick from the standard maneuvers catalog (filtered by tier + raidType).">+ Add Maneuver</button>
        </div>
        <div class="ft-block-hint">Maneuvers consumed by the raid engine. Different from the manifestation library on the Manifestations tab.</div>
        {{#if maneuverPills.length}}
        <div class="ft-boss-maneuver-list">
          {{#each maneuverPills as |m|}}
          <span class="ft-meta-pill ft-maneuver-pill{{#unless m.found}} ft-maneuver-pill-unresolved{{/unless}}" data-maneuver-key="{{m.key}}"
                {{#if m.opSummary}}data-tooltip="{{m.opSummary}}"{{/if}}>
            {{#if m.tierBucket}}<span class="ft-manifest-chip ft-tier-pill ft-tier-{{m.tier}} ft-maneuver-tier">{{m.tierBucket}}</span>{{/if}}
            <span class="ft-meta-val">{{m.label}}</span>
            {{#unless m.found}}<span class="ft-maneuver-warn" data-tooltip="Not found in current EFFECTS catalog — stale key, module unloaded, or typo.">?</span>{{/unless}}
            <button type="button" class="ft-mini-btn" data-action="ftBossManeuverRemove" data-tooltip="Remove">×</button>
          </span>
          {{/each}}
        </div>
        {{else}}
        <div class="ft-rig-item-empty">No maneuvers yet. Click <b>+ Add Maneuver</b> to pick from the catalog.</div>
        {{/if}}
      </section>
    </div>

    {{!-- BEHAVIORS TAB --}}
    <div class="tab behaviors{{#if (eq activeTab "behaviors")}} active{{/if}}" data-tab="behaviors">
      <section class="ft-boss-behavior-list bbttcc-panel">
        <div class="ft-block-title">Installed Behaviors
          <span class="ft-block-hint">(fired by the raid engine on phase triggers)</span>
          <button type="button" class="ft-action-btn ft-block-action" data-action="ftBossNormalize" data-tooltip="Dedupe + canonicalize behaviors">Normalize</button>
        </div>
        {{#if behaviorRows.length}}
        <table class="ft-behavior-table">
          <thead><tr><th>#</th><th>ID</th><th>Label</th><th>Phase</th><th>When</th><th>End Raid</th><th></th></tr></thead>
          <tbody>
            {{#each behaviorRows as |b|}}
            <tr data-behavior-idx="{{b.idx}}">
              <td>{{b.idx}}</td>
              <td><code>{{b.id}}</code></td>
              <td>{{b.label}}</td>
              <td>
                <select class="ft-behavior-phase-select" data-action="ftBossBehaviorPhaseSet" data-behavior-idx="{{b.idx}}"
                        data-tooltip="Phase at which this behavior fires.">
                  <option value="any" {{#if (eq b.phase "any")}}selected{{/if}}>any</option>
                  <option value="1"   {{#if (eq b.phase "1")}}selected{{/if}}{{#if (eq b.phase 1)}}selected{{/if}}>1</option>
                  <option value="2"   {{#if (eq b.phase "2")}}selected{{/if}}{{#if (eq b.phase 2)}}selected{{/if}}>2</option>
                  <option value="3"   {{#if (eq b.phase "3")}}selected{{/if}}{{#if (eq b.phase 3)}}selected{{/if}}>3</option>
                  <option value="4"   {{#if (eq b.phase "4")}}selected{{/if}}{{#if (eq b.phase 4)}}selected{{/if}}>4</option>
                  <option value="5"   {{#if (eq b.phase "5")}}selected{{/if}}{{#if (eq b.phase 5)}}selected{{/if}}>5</option>
                </select>
              </td>
              <td><small>{{b.whenSummary}}</small></td>
              <td>{{b.endRaid}}</td>
              <td><button type="button" class="ft-mini-btn" data-action="ftBossPowerRemove" data-tooltip="Remove behavior">×</button></td>
            </tr>
            {{/each}}
          </tbody>
        </table>
        {{else}}
        <div class="ft-rig-item-empty">No behaviors installed. Use Powers tab to add from the registry.</div>
        {{/if}}
      </section>

      {{!-- Raw JSON tucked into collapsed details — GM-only escape hatch --}}
      <details class="ft-boss-behavior-raw bbttcc-collapse-block">
        <summary>
          <span class="ft-block-title-inline">Advanced — raw behaviors JSON</span>
          <span class="ft-block-hint">(direct edit; bypasses validation)</span>
        </summary>
        <textarea data-ft-boss-edit="system.raidProfile.behaviorsRaw" rows="10" spellcheck="false">{{raidProfile.behaviorsRaw}}</textarea>
      </details>
    </div>

    {{!-- RAID PROFILE TAB — Slice 4 (2026-05-12): authoring-only surface.
         Live State moved to GM Edit. Header config + OP grid get boxed-tile
         pattern for parity with the rest of the polished sheet. --}}
    <div class="tab raid{{#if (eq activeTab "raid")}} active{{/if}}" data-tab="raid">
      <section class="ft-boss-raid-config">
        <div class="ft-block-title">Raid Authoring <span class="ft-block-hint">drives raid engine resolution + OP economy reads</span></div>
        <div class="ft-boss-raid-grid">
          <div class="ft-meta">
            <label data-tooltip="Raid mode — drives raid engine resolution path.">Mode</label>
            <select data-ft-boss-edit="system.raidProfile.mode">
              <option value="hybrid"{{#if (eq raidProfile.mode "hybrid")}} selected{{/if}}>hybrid</option>
              <option value="violence"{{#if (eq raidProfile.mode "violence")}} selected{{/if}}>violence</option>
              <option value="intrigue"{{#if (eq raidProfile.mode "intrigue")}} selected{{/if}}>intrigue</option>
              <option value="softpower"{{#if (eq raidProfile.mode "softpower")}} selected{{/if}}>softpower</option>
              <option value="custom"{{#if (eq raidProfile.mode "custom")}} selected{{/if}}>custom</option>
            </select>
          </div>
          <div class="ft-meta">
            <label data-tooltip="Legacy morale hits. Damage ladder is preferred.">Morale Hits (legacy)</label>
            <input type="number" data-ft-boss-edit="system.raidProfile.moraleHits" value="{{raidProfile.moraleHits}}" min="0" max="99"/>
          </div>
          <div class="ft-meta full">
            <label data-tooltip="Comma-separated damage ladder. e.g. 'wounded, enraged, crippled, slain'">Hit Track / Damage Ladder</label>
            <input type="text" data-ft-boss-edit="system.raidProfile.hitTrack" value="{{raidProfile.hitTrack}}" placeholder="shaken, wounded, broken, banished"/>
          </div>
        </div>
      </section>

      <section class="ft-boss-op-stats">
        <div class="ft-block-title">OP Economy Stats <span class="ft-block-hint">raid engine reads these per round</span></div>
        <div class="ft-boss-op-tile-grid">
          {{#each opEntries as |e|}}
          <div class="ft-boss-op-tile">
            <span class="ft-boss-op-tile-label">{{e.label}}</span>
            <input type="number" class="ft-boss-op-tile-input" data-ft-boss-edit="system.raidProfile.opStats.{{e.key}}" value="{{e.value}}" min="0"/>
          </div>
          {{/each}}
        </div>
      </section>
    </div>

    {{!-- GM EDIT TAB — Slice 4 (2026-05-12): now hosts Live Raid State (read-
         only) + Manual Overrides. Live State moved here from Raid Profile so
         that tab can stay pure-authoring. --}}
    {{#if gmEdit}}
    <div class="tab gmedit{{#if (eq activeTab "gmedit")}} active{{/if}}" data-tab="gmedit">

      {{!-- Live State — populated by raid console (Phase 7 bridge). Always
           rendered; reads zeros when no raid is active. Damage Tracking
           Unification 2026-05-14: Morale tile retired (bosses don't have
           morale — they have integrity + phases, which are the canonical
           "how hurt is the boss" signal). Integrity tile takes its place
           and reads from the actor's own integrity track (always live). --}}
      <section class="ft-boss-live-state">
        <div class="ft-block-title">Live Raid State
          <span class="ft-block-hint">read-only · integrity is canonical · the other three are populated by the raid console while a raid is in progress</span>
        </div>
        <div class="ft-boss-live-state-grid">
          <div class="ft-boss-live-tile" data-tooltip="Rounds elapsed in the current raid.">
            <div class="ft-boss-live-label">Rounds</div>
            <div class="ft-boss-live-val">{{raidStats.rounds}}</div>
          </div>
          <div class="ft-boss-live-tile" data-tooltip="Boss integrity — the canonical damage track. Phase ladder derives from this.">
            <div class="ft-boss-live-label">Integrity</div>
            <div class="ft-boss-live-val">{{integrity.value}}/{{integrity.max}}</div>
          </div>
          <div class="ft-boss-live-tile" data-tooltip="Attacker infiltration progress.">
            <div class="ft-boss-live-label">Infiltration</div>
            <div class="ft-boss-live-val">{{raidStats.infiltration}}</div>
          </div>
          <div class="ft-boss-live-tile" data-tooltip="Boss alarm level — rises with detection events; tier-gated triggers.">
            <div class="ft-boss-live-label">Alarm</div>
            <div class="ft-boss-live-val">{{raidStats.alarm}}</div>
          </div>
        </div>
      </section>

      {{!-- Template picker moved to Powers tab (2026-05-11). GM Edit keeps the
           manual schema editor below for direct stat overrides. --}}
      <section class="ft-boss-gm-grid">
        <div class="ft-block-title">Manual Overrides
          <span class="ft-block-hint">bypass schema pipeline — use for fixing stuck state or one-off scenario tweaks</span>
        </div>
        <div class="ft-meta">
          <label>Integrity Max</label>
          <input type="number" data-ft-boss-edit="system.integrity.max" value="{{integrity.max}}" min="0"/>
        </div>
        <div class="ft-meta">
          <label>Integrity Current</label>
          <input type="number" data-ft-boss-edit="system.integrity.value" value="{{integrity.value}}" min="0"/>
        </div>
        <div class="ft-meta">
          <label>Tier</label>
          <input type="number" data-ft-boss-edit="system.integrity.tier" value="{{integrity.tier}}" min="1" max="4"/>
        </div>
        <div class="ft-meta">
          <label>Bracket</label>
          <select data-ft-boss-edit="system.integrity.bracket">
            <option value="personal"{{#if (eq integrity.bracket "personal")}} selected{{/if}}>Personal</option>
            <option value="light"{{#if (eq integrity.bracket "light")}} selected{{/if}}>Light</option>
            <option value="medium"{{#if (eq integrity.bracket "medium")}} selected{{/if}}>Medium</option>
            <option value="heavy"{{#if (eq integrity.bracket "heavy")}} selected{{/if}}>Heavy</option>
            <option value="siege"{{#if (eq integrity.bracket "siege")}} selected{{/if}}>Siege</option>
          </select>
        </div>
        <div class="ft-meta">
          <label>Surge Max</label>
          <input type="number" data-ft-boss-edit="system.manifestations.surge.max" value="{{manifestations.surge.max}}" min="0"/>
        </div>
        <div class="ft-meta">
          <label>Current Phase Index</label>
          <input type="number" data-ft-boss-edit="system.phases.currentPhase" value="{{phases.currentPhase}}" min="0"/>
        </div>
      </section>

    </div>
    {{/if}}

  </div>
</div>
