    {{!-- Resonance Dice --}}
    <span class="ft-chip ft-chip-resonance" data-tooltip="Resonance Dice — auto-gain 1 at turn start (cap = max). Spend at cast time: +1 Resolve DC · extra damage die · extend duration · impose 3d10kl2 on a defense · stabilize vs counter/dispel. Refills on Soma Break." style="background:#1f1f3a;color:#c8c8ff;border:1px solid #5a3a8a;padding:0.18rem 0.4rem;border-radius:4px;font-size:0.76rem;display:inline-flex;align-items:center;gap:0.25rem;">✦ Resonance
      <input type="number" name="system.resources.resonanceDice.current" value="{{cosmicLinguistState.resonance.current}}" min="0" max="{{cosmicLinguistState.resonance.max}}" style="width:28px;background:transparent;color:inherit;border:1px solid #5a3a8a;border-radius:2px;text-align:center;font-size:0.76rem;padding:0;"/>
      / {{cosmicLinguistState.resonance.max}}
    </span>

    {{!-- Strain (friction counter) --}}
    <span class="ft-chip ft-chip-strain" data-tooltip="Strain — friction counter, ticks up on aggressive Resonance use (forcing contradiction / misaligned power). Resets to 0 on Soma Break. Soft cap 10." style="background:#3a1f1f;color:#ffc8c8;border:1px solid #8a3a3a;padding:0.18rem 0.4rem;border-radius:4px;font-size:0.76rem;display:inline-flex;align-items:center;gap:0.25rem;">⚡ Strain
      <input type="number" name="system.resources.strain.value" value="{{cosmicLinguistState.strain.value}}" min="0" max="{{cosmicLinguistState.strain.max}}" style="width:28px;background:transparent;color:inherit;border:1px solid #8a3a3a;border-radius:2px;text-align:center;font-size:0.76rem;padding:0;"/>
      / {{cosmicLinguistState.strain.max}}
    </span>

    {{!-- Editorial Authority + class buttons --}}
    <span class="ft-chip ft-chip-authority" data-tooltip="Editorial Authority — narrative currency from listening / correcting error / being cited. Spent on Annotations (Authority dialog). Refills on Soma Break." style="background:#3a2f1a;color:#f5d97a;border:1px solid #8a6a2a;padding:0.18rem 0.4rem;border-radius:4px;font-size:0.76rem;display:inline-flex;align-items:center;gap:0.25rem;">📎 Authority
      <input type="number" name="system.resources.clAuthority.current" value="{{cosmicLinguistState.authority.current}}" min="0" max="{{cosmicLinguistState.authority.max}}" style="width:28px;background:transparent;color:inherit;border:1px solid #8a6a2a;border-radius:2px;text-align:center;font-size:0.76rem;padding:0;"/>
      / {{cosmicLinguistState.authority.max}}
    </span>
    <button type="button" class="ft-npc-tool" data-action="ftClassAction" data-handler="cosmic_linguist_authority"  data-tooltip="Roll the Editorial Authority pool.">Pool</button>
    <button type="button" class="ft-npc-tool" data-action="ftClassAction" data-handler="cosmic_linguist_annotation" data-tooltip="Compose an Annotation — spend Authority to author an Edit (Annotation dialog).">Edit</button>
  </section>
  {{/if}}

  {{#if pactkeeperState}}
  <section class="ft-npc-class-panel ft-npc-pactkeeper" style="display:flex; flex-wrap:wrap; align-items:center; gap:0.35rem; padding:0.35rem 0.6rem; border-bottom:1px solid rgba(120,120,120,0.18); background:rgba(58,106,90,0.06);">
    <span style="font-weight:700; color:#a0c8b8; letter-spacing:.04em;">§ Pactkeeper</span>

    {{!-- Leverage pool + class buttons --}}
    <span class="ft-chip ft-chip-leverage" data-tooltip="Leverage — narrative currency gained from agreements/favors/precedent. Spent on Binding Clauses. Refills on Soma Break." style="background:#1f2a2a;color:#a0c8b8;border:1px solid #3a6a5a;padding:0.18rem 0.4rem;border-radius:4px;font-size:0.76rem;display:inline-flex;align-items:center;gap:0.25rem;">§ Leverage
      <input type="number" name="system.resources.pactLeverage.current" value="{{pactkeeperState.leverage.current}}" min="0" max="{{pactkeeperState.leverage.max}}" style="width:28px;background:transparent;color:inherit;border:1px solid #3a6a5a;border-radius:2px;text-align:center;font-size:0.76rem;padding:0;"/>
      / {{pactkeeperState.leverage.max}}
    </span>
    <button type="button" class="ft-npc-tool" data-action="ftClassAction" data-handler="pactkeeper_leverage"        data-tooltip="Roll the Leverage pool (Soul mod dice).">Pool</button>
    <button type="button" class="ft-npc-tool" data-action="ftClassAction" data-handler="pactkeeper_binding_clause"  data-tooltip="Spend Leverage to create a Binding Clause on a target / situation.">Bind</button>
    <button type="button" class="ft-npc-tool" data-action="ftClassAction" data-handler="pactkeeper_precedent"       data-tooltip="Invoke a Precedent — narrative reroll/anchor.">Precedent</button>

    {{!-- Civic Charge --}}
    <span class="ft-chip ft-chip-civic-charge" data-tooltip="Civic Charge dice (die size scales L1-4 d6, L5+ d8, L11+ d10, L17+ d12). Earned ≤1/round by stabilizing volatile situations. Spend for Stabilization/Authority/Enforcement/Containment/Closure." style="background:#3a2a4a;color:#d4b8e8;border:1px solid #6a4a8a;padding:0.18rem 0.4rem;border-radius:4px;font-size:0.76rem;display:inline-flex;align-items:center;gap:0.25rem;">🗂 Civic Charge
      <input type="number" name="system.resources.civicCharge.dice" value="{{pactkeeperState.civicCharge.dice}}" min="0" max="{{pactkeeperState.civicCharge.maxDice}}" style="width:28px;background:transparent;color:inherit;border:1px solid #6a4a8a;border-radius:2px;text-align:center;font-size:0.76rem;padding:0;"/>
      / {{pactkeeperState.civicCharge.maxDice}} {{pactkeeperState.civicCharge.dieSize}}
    </span>
    <button type="button" class="ft-npc-tool" data-action="ftClassAction" data-handler="pactkeeper_spend_civic_charge" data-tooltip="Roll a Civic Charge die and spend on Stabilization / Authority Boost / Enforcement / Containment / Closure.">Spend</button>

    {{!-- Administrative Pressure --}}
    <span class="ft-chip ft-chip-pressure ft-pressure-{{pactkeeperState.pressure.band}}" data-tooltip="Administrative Pressure — bureaucratic + metaphysical strain. 1-2 Low / 3-5 Moderate / 6+ High. Cleared by downtime, proper closure, or delegation." style="background:#3a1f1f;color:#ffc8a0;border:1px solid #8a5a3a;padding:0.18rem 0.4rem;border-radius:4px;font-size:0.76rem;display:inline-flex;align-items:center;gap:0.25rem;">⚖ Pressure
      <input type="number" name="system.resources.administrativePressure.value" value="{{pactkeeperState.pressure.value}}" min="0" max="{{pactkeeperState.pressure.max}}" style="width:28px;background:transparent;color:inherit;border:1px solid #8a5a3a;border-radius:2px;text-align:center;font-size:0.76rem;padding:0;"/>
      <span style="opacity:0.8;font-size:0.72rem;">({{pactkeeperState.pressure.bandLabel}})</span>
    </span>

    {{!-- Pact Subject --}}
    <button type="button" class="ft-chip ft-chip-pact-subject" data-action="ftClassAction" data-handler="pactkeeper_bind_subject" data-tooltip="Pact Subject — the creature/object/place bargained with. Sustained manifestations targeting it get free upkeep (capped by concurrencyBonus). Click to bind targeted token, or clear." style="background:{{#if pactkeeperState.pactSubject}}#1f3a2a{{else}}#2a2a2a{{/if}};color:{{#if pactkeeperState.pactSubject}}#a0d8b8{{else}}#888{{/if}};border:1px solid {{#if pactkeeperState.pactSubject}}#3a8a5a{{else}}#5a5a5a{{/if}};padding:0.18rem 0.4rem;border-radius:4px;font-size:0.76rem;cursor:pointer;">{{#if pactkeeperState.pactSubject}}🔗 Pact: {{pactkeeperState.pactSubject.name}}{{else}}🔓 Bind Pact Subject{{/if}}</button>
  </section>
  {{/if}}

  <section class="ft-npc-body">
    {{#if hasStrikes}}
    <div class="ft-npc-section">
      <div class="ft-section-header"><h3>Strikes</h3><span class="ft-mini-count">{{strikeRows.length}}</span></div>
      <div class="ft-item-list">
        {{#each strikeRows as |s|}}
        <div class="ft-item-row" data-item-id="{{s.id}}">
          <div class="ft-item-summary">
            <img src="{{s.img}}" class="ft-item-art" alt="{{s.name}}"/>
            <span class="ft-item-name">{{s.name}}</span>
            {{#if s.formula}}<span class="ft-item-meta">{{s.formula}} {{s.type}}</span>{{/if}}
            {{#if s.category}}<span class="ft-item-meta">{{s.category}}</span>{{/if}}
            <div class="ft-item-controls">
              <button type="button" data-action="ftWeaponRoll" data-item-id="{{s.id}}" class="ft-roll-btn">Strike</button>
              <button type="button" data-action="ftItemEdit"   data-item-id="{{s.id}}" class="ft-item-edit">⚙</button>
              <button type="button" data-action="ftItemDelete" data-item-id="{{s.id}}" class="ft-power-delete">✕</button>
            </div>
          </div>
        </div>
        {{/each}}
      </div>
    </div>
    {{/if}}

    <div class="ft-npc-section">
      <div class="ft-section-header ft-manifest-header">
        <div>
          <h3>Manifestations &amp; Features</h3>
          {{#if hasManifestations}}<span class="ft-mini-count">{{manifestRows.length}}</span>{{/if}}
        </div>
        <div class="ft-header-actions">
          <button type="button" data-action="ftManifestCreate" class="ft-add-btn" data-tooltip="Open the Manifestation Engine to author a custom NPC ability (breath weapon, aura, signature attack…).">+ Add Feature</button>
          <details class="ft-header-overflow">
            <summary class="ft-add-btn ft-add-btn-subtle">⋯</summary>
            <div class="ft-header-overflow-menu">
              {{#if actorIsTCC}}<button type="button" data-action="ftPowerCreate"  class="ft-add-btn" data-tooltip="Working preset — instant cast (TCC only).">Working</button>{{/if}}
              <button type="button" data-action="ftWeaponCreate" class="ft-add-btn" data-tooltip="Form preset — Stable manifestation with a Strike attack profile.">Form</button>
              <button type="button" data-action="ftManifestCreate" data-starter="ritual" class="ft-add-btn" data-tooltip="Ritual preset — Ongoing/scene-bound manifestation.">Ritual</button>
              <button type="button" data-action="ftManifestCreate" data-starter="stable" class="ft-add-btn" data-tooltip="Stable preset — bound manifestation that persists across turns.">Stable</button>
            </div>
          </details>
        </div>
      </div>
      {{#if hasManifestations}}
      <div class="ft-item-list">
        {{#each manifestRows as |m|}}
        <details class="ft-item-row" data-item-id="{{m.id}}">
          <summary class="ft-item-summary">
            <img src="{{m.img}}" class="ft-item-art" alt="{{m.name}}"/>
            <span class="ft-item-name">{{m.name}}</span>
            <span class="ft-manifest-chip ft-tier-pill ft-tier-{{m.tier}}">{{m.tierLabel}}</span>
            <span class="ft-manifest-chip">{{m.stabilityLabel}}</span>
            <span class="ft-item-meta">{{m.costLabel}}</span>
            <div class="ft-item-controls">
              {{#if m.isForm}}
              <button type="button" data-action="ftWeaponRoll" data-item-id="{{m.id}}" class="ft-roll-btn">Strike</button>
              <button type="button" data-action="ftCast"       data-item-id="{{m.id}}" class="ft-roll-btn ft-roll-btn-subtle">Invoke</button>
              {{else}}
              <button type="button" data-action="ftCastPower"  data-item-id="{{m.id}}" class="ft-roll-btn">{{m.actionLabel}}</button>
              {{/if}}
              <button type="button" data-action="ftItemEdit"   data-item-id="{{m.id}}" class="ft-item-edit">⚙</button>
              <button type="button" data-action="ftItemDelete" data-item-id="{{m.id}}" class="ft-power-delete">✕</button>
            </div>
          </summary>
          <div class="ft-manifest-detail">
            {{#if m.signature}}<div class="ft-manifest-signature">Signature: {{m.signature}}</div>{{/if}}
            {{#if m.desc}}<div class="ft-item-desc">{{m.desc}}</div>{{/if}}
          </div>
        </details>
        {{/each}}
      </div>
      {{else}}
      <p class="ft-hint" style="margin:0.5rem 0;font-size:0.78rem;opacity:0.6;font-style:italic">No manifestations yet — use <em>+ Add Feature</em> to author one with the Manifestation Engine.</p>
      {{/if}}

      {{!-- NPC Parity Sprint C (2026-05-14) — Active manifestations strip.
            Mirrors the char-sheet's "Active" sub-section under the
            Manifestations list. End Scene charges upkeep; per-row ✕ drops
            the active instance (not the item — different from ftItemDelete). --}}
      {{#if activeManifestations.length}}
      <div class="ft-manifest-active-strip" style="margin-top:0.4rem; padding-top:0.4rem; border-top:1px dashed rgba(120,120,120,0.25);">
        <div class="ft-section-header" style="margin-bottom:0.25rem;">
          <h4 style="margin:0; font-size:0.82rem; opacity:0.85;">Active</h4>
          <span class="ft-mini-count">{{activeManifestations.length}}</span>
          <button type="button" data-action="ftManifestEndScene" class="ft-npc-tool" data-tooltip="Charge Sustained upkeep — 1 Clarity × tier per active Sustained manifestation; drops those whose actor can't pay.">End Scene</button>
        </div>
        <div class="ft-item-list">
          {{#each activeManifestations as |a|}}
          <div class="ft-item-row ft-item-row--active" style="background:rgba(160,180,255,0.04);">
            <div class="ft-item-summary">
              <img src="{{a.img}}" class="ft-item-art" data-tooltip="{{a.name}}"/>
              <span class="ft-item-name">{{a.name}}</span>
              <span class="ft-manifest-chip ft-tier-pill ft-tier-{{a.tier}}">T{{a.tier}}</span>
              <span class="ft-manifest-chip">{{a.stabilityLabel}}</span>
              {{#if a.upkeepHint}}<span class="ft-item-meta">{{a.upkeepHint}}</span>{{/if}}
              <div class="ft-item-controls">
                <button type="button" data-action="ftManifestDrop" data-instance-id="{{a.instanceId}}" class="ft-power-delete" data-tooltip="Drop this active manifestation (clears instance + any sustained AEs).">✕</button>
              </div>
            </div>
          </div>
          {{/each}}
        </div>
      </div>
      {{/if}}
    </div>

    {{#if hasClassIdentity}}
    <div class="ft-npc-section">
      <div class="ft-section-header"><h3>Path &amp; Doctrine</h3><span class="ft-mini-count">{{classRows.length}}</span></div>
      <div class="ft-item-list">
        {{#each classRows as |c|}}
        <div class="ft-item-row" data-item-id="{{c.id}}">
          <div class="ft-item-summary">
            <img src="{{c.img}}" class="ft-item-art" alt="{{c.name}}"/>
            <span class="ft-item-name">{{c.name}}</span>
            <span class="ft-item-meta">{{c.typeLabel}}</span>
            {{#if c.identifier}}<span class="ft-item-meta" style="opacity:0.6">{{c.identifier}}</span>{{/if}}
            <div class="ft-item-controls">
              <button type="button" data-action="ftItemEdit"   data-item-id="{{c.id}}" class="ft-item-edit">⚙</button>
              <button type="button" data-action="ftItemDelete" data-item-id="{{c.id}}" class="ft-power-delete">✕</button>
            </div>
          </div>
        </div>
        {{/each}}
      </div>
      <div class="ft-class-tip" style="margin-top:0.3rem;padding:0.4rem;background:#1a1a1f;border:1px dashed #3a3a4a;border-radius:4px;font-size:0.72rem;color:#a8a8b8;font-style:italic;display:flex;flex-direction:column;gap:0.35rem;">
        <span>Drag a Path / Doctrine / Ancestry / Heritage from the compendium — auto-grants its tier-1 principles + grants on drop. <b>▲ Advance Initiation</b> applies subsequent levels.</span>
        <div style="display:flex;gap:0.4rem;flex-wrap:wrap">
          <button type="button" class="ft-add-btn ft-add-btn-subtle" data-action="ftApplyPathFeatures" data-tooltip="Re-pull every Path / Doctrine principle the creature is eligible for at its current level. Idempotent (skips owned).">⊕ Apply Path Features</button>
          <button type="button" class="ft-add-btn ft-add-btn-subtle" data-action="ftGrantSkillRanks" data-tooltip="Auto-grant aptitude rank 1 for any aptitudes named in path principles.">⊕ Grant Aptitudes</button>
        </div>
      </div>
    </div>
    {{/if}}

    {{#if hasFeatures}}
    <div class="ft-npc-section">
      <div class="ft-section-header"><h3>Features &amp; Traits</h3><span class="ft-mini-count">{{featureRows.length}}</span></div>
      <div class="ft-item-list">
        {{#each featureRows as |f|}}
        <details class="ft-item-row" data-item-id="{{f.id}}">
          <summary class="ft-item-summary">
            <img src="{{f.img}}" class="ft-item-art" alt="{{f.name}}"/>
            <span class="ft-item-name">{{f.name}}</span>
            <span class="ft-item-meta">{{f.type}}</span>
            <div class="ft-item-controls">
              {{#if f.hasActiveAbility}}
              <button type="button" data-action="ftUseFeature" data-item-id="{{f.id}}" class="ft-roll-btn" data-tooltip="Activate / invoke this feature">▶ Use</button>
              {{/if}}
              <button type="button" data-action="ftItemEdit"   data-item-id="{{f.id}}" class="ft-item-edit">⚙</button>
              <button type="button" data-action="ftItemDelete" data-item-id="{{f.id}}" class="ft-power-delete">✕</button>
            </div>
          </summary>
          {{#if f.desc}}
          <div class="ft-item-desc">{{{f.desc}}}</div>
          {{/if}}
        </details>
        {{/each}}
      </div>
    </div>
    {{/if}}

    {{!-- Aptitudes — folded by default since the 23-row ladder is heavy.
         Pip clicks set rank; rank input visible only in edit mode. --}}
    <details class="ft-npc-section ft-npc-aptitudes-fold">
      <summary><div class="ft-section-header"><h3 style="display:inline">Aptitudes</h3><span style="font-size:0.72rem;opacity:0.6;font-style:italic;margin-left:0.5rem">click pips to set rank</span></div></summary>
      <div class="ft-skills-grid">
        <div class="ft-skills-header">
          <span class="ft-skill-col ft-skill-col-name"  data-tooltip="Aptitude name and current rank label.">Aptitude</span>
          <span class="ft-skill-col ft-skill-col-attr"  data-tooltip="Faculty this aptitude keys off.">Faculty</span>
          <span class="ft-skill-col ft-skill-col-rank"  data-tooltip="Trained rank (0–5).">Rank</span>
          <span class="ft-skill-col ft-skill-col-ae"    data-tooltip="Active-effect bonus from items.">AE</span>
          <span class="ft-skill-col ft-skill-col-total" data-tooltip="Total bonus added to the 2d10x10 roll.">Total</span>
          <span class="ft-skill-col ft-skill-col-action"></span>
        </div>
        {{#each enrichedSkills as |skill|}}
        <div class="ft-skill-row" data-skill="{{skill.key}}" data-tooltip="{{skill.breakdown}}">
          <div class="ft-skill-col ft-skill-col-name">
            <span class="ft-skill-name">{{skill.label}}</span>
            <span class="ft-skill-rank-label" style="color:{{skill.rankData.color}}" data-tooltip="{{skill.rankData.label}}">{{skill.rankData.label}}</span>
          </div>
          <div class="ft-skill-col ft-skill-col-attr">
            <span class="ft-skill-attr-name">{{ftCap skill.attribute}}</span>
            <span class="ft-skill-col-val">+{{skill.attrBonus}}</span>
          </div>
          <div class="ft-skill-col ft-skill-col-rank">
            <div class="ft-skill-rank-pips">
              {{#each skill.pips as |pip|}}
              <span class="ft-rank-pip {{#if pip.filled}}filled{{/if}}"
                    data-action="ftSetSkillRank"
                    data-target-rank="{{pip.idx}}"
                    data-tooltip="Click to set rank {{pip.idx}}{{#if pip.filled}} · click filled pip again to decrement{{/if}}"
                    {{#if pip.filled}}style="background:{{pip.color}};border-color:{{pip.color}}"{{/if}}></span>
              {{/each}}
            </div>
            <span class="ft-skill-col-val">+{{skill.rankData.bonus}}</span>
            <input type="number" name="system.skills.{{skill.key}}.value"
                   value="{{skill.rank}}" min="0" max="5"
                   class="ft-skill-rank-input ft-edit-only" data-tooltip="Edit rank directly (edit mode)"/>
          </div>
          <div class="ft-skill-col ft-skill-col-ae">
            {{#if skill.aeBonus}}<span class="ft-skill-col-val ft-skill-ae-bonus">+{{skill.aeBonus}}</span>{{else}}<span class="ft-skill-col-val ft-skill-col-empty">—</span>{{/if}}
          </div>
          <div class="ft-skill-col ft-skill-col-total">
            <span class="ft-skill-total-num">+{{skill.totalBonus}}</span>
          </div>
          <div class="ft-skill-col ft-skill-col-action">
            <button type="button" data-action="ftSkillRoll" data-skill="{{skill.key}}" data-attribute="{{skill.attribute}}" class="ft-skill-roll-btn">Roll</button>
          </div>
        </div>
        {{/each}}
      </div>
    </details>

    {{!-- Inventory — gear, armor, mundane (non-manifested) weapons. Crafted
         items show in the Manifestations section instead. --}}
    <div class="ft-npc-section">
      <div class="ft-section-header ft-inventory-header">
        <h3>Inventory</h3>
        {{#if hasInventory}}<span class="ft-mini-count">{{gear.length}}</span>{{/if}}
        <div class="ft-inv-tools" style="margin-left:auto;display:flex;gap:0.4rem">
          <button type="button" class="ft-add-btn ft-add-btn-subtle" data-action="ftGather" data-tooltip="Gather materials from harvest nodes in this scene">🜨 Gather</button>
          <button type="button" class="ft-add-btn ft-add-btn-subtle" data-action="ftForge"  data-tooltip="Open the Forge — craft items from materials">⚒ Forge</button>
        </div>
      </div>
      {{> "systems/fourththing/templates/partials/inventory-list.hbs" items=gear}}
    </div>

    <div class="ft-npc-section">
      <div class="ft-section-header"><h3>Conditions</h3>{{#if hasActiveConditions}}<span class="ft-mini-count">{{activeConditions.length}}</span>{{/if}}</div>
      <div class="ft-condition-grid">
        {{#each conditionList as |c|}}
        <button type="button" class="ft-condition-chip {{#if c.active}}active{{/if}}" data-action="ftConditionToggle" data-condition="{{c.key}}" data-tooltip="{{c.desc}}" style="{{#if c.active}}border-color:{{c.color}};color:{{c.color}};{{/if}}">{{c.label}}</button>
        {{/each}}
      </div>
    </div>

    <div class="ft-npc-section">
      <div class="ft-section-header"><h3>GM Notes</h3></div>
      <textarea name="system.notes" rows="6" placeholder="Behaviors, motivations, hooks, encounter notes…">{{system.notes}}</textarea>
      <div class="ft-npc-tags">
        <label>Tags</label>
        <input type="text" name="system.tags" value="{{system.tags}}" placeholder="e.g. elite, qliphothic, faction-npc"/>
      </div>
    </div>

    <details class="ft-npc-section ft-def-editor-fold">
      <summary><h3 style="display:inline">Defense / Condition Immunity Editor</h3></summary>
      <label class="ft-def-editor-label">Resist / immune (cycle)</label>
      <div class="ft-def-chips ft-def-chips-edit">
        {{#each defenseTypes as |t|}}
          <button type="button" class="ft-chip ft-chip-edit {{#if t.baseImmune}}ft-chip-immune{{else if t.baseResist}}ft-chip-resist{{else}}ft-chip-none{{/if}}" data-action="ftDefenseCycle" data-type="{{t.key}}" data-tooltip="{{t.label}}">{{#if t.baseImmune}}⦿{{else if t.baseResist}}◑{{else}}○{{/if}} {{t.label}}</button>
        {{/each}}
      </div>
      <label class="ft-def-editor-label">Vulnerable (toggle)</label>
      <div class="ft-def-chips ft-def-chips-edit">
        {{#each defenseTypes as |t|}}
          <button type="button" class="ft-chip ft-chip-edit {{#if t.baseVuln}}ft-chip-vuln{{else}}ft-chip-none{{/if}}" data-action="ftVulnToggle" data-type="{{t.key}}">{{#if t.baseVuln}}▲{{else}}○{{/if}} {{t.label}}</button>
        {{/each}}
      </div>
      <label class="ft-def-editor-label">Condition immune (toggle)</label>
      <div class="ft-def-chips ft-def-chips-edit">
        {{#each condImmunityList as |c|}}
          <button type="button" class="ft-chip ft-chip-edit {{#if c.baseImmune}}ft-chip-cond-immune{{else}}ft-chip-none{{/if}}" data-action="ftCondImmuneToggle" data-condition="{{c.key}}">{{#if c.baseImmune}}✦{{else}}○{{/if}} {{c.label}}</button>
        {{/each}}
      </div>
    </details>

  </section>
</div>
